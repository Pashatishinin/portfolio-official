---
interface Props {
  text?: string;
  img: string | null;
}

const { text, img } = Astro.props;
---

<section class="relative">
  <div class="flex flex-col text-main h-svh">
    <div class="h-full image">
      {
        img && (
          <img
            src={img}
            alt={text}
            width="2400"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const animateImage = () => {
    const img = document.querySelector<HTMLElement>(".image img");
    if (!img) return;

    gsap.killTweensOf(img);
    gsap.set(img, {
      scale: 1.05,
      rotation: 4,
      transformOrigin: "center center",
    });
    gsap.to(img, {
      scale: 1,
      rotation: 0,
      duration: 1.4,
      ease: "expo.out",
    });
  };

  const initParallax = () => {
    const section = document
      .querySelector<HTMLElement>(".image")
      ?.closest("section");
    const img = document.querySelector<HTMLElement>(".image img");
    if (!section || !img) return;

    ScrollTrigger.getAll().forEach((trigger) => {
      if (trigger.vars.trigger === section) trigger.kill();
    });

    gsap.fromTo(
      img,
      { yPercent: -4 },
      {
        yPercent: 4,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      },
    );
  };

  document.addEventListener("astro:page-load", () => {
    animateImage();
    initParallax();
  });
</script>
