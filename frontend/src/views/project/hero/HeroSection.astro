---
interface Props {
  text?: string;
  img: string | null;
}

const { text, img } = Astro.props;
---

<section class="relative">
  <!-- <div class="back z-10 fixed top-0 left-0 bg-main h-screen w-screen"></div> -->
  <div class="flex flex-col text-main h-screen">
    <!-- <div class="p-4 sm:p-16 pt-32 text-center">
      <h1 class="text-[clamp(48px,11vw,180px)] -tracking-widest leading-[80%]">
        <TextEffect delay={0.4} wait>{text}</TextEffect>
      </h1>
    </div> -->

    <div class="h-full image">
      {
        img && (
          <img
            src={img}
            alt={text}
            width="2400"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .image {
    position: relative;
    overflow: hidden;
  }

  .image img {
    position: relative;
    top: -15%;
    height: 130%;
    width: 100%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }

  p {
    font-size: 18px;
    line-height: 95%;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const animateImage = () => {
    const img = document.querySelector<HTMLElement>(".image img");
    if (!img) return;

    gsap.killTweensOf(img);
    gsap.set(img, {
      scale: 1.05,
      rotation: 4,
      transformOrigin: "center center",
    });
    gsap.to(img, {
      scale: 1,
      rotation: 0,
      duration: 1.4,
      ease: "expo.out",
    });
  };

  const initParallax = () => {
    const section = document.querySelector<HTMLElement>(".image")?.closest("section");
    const img = document.querySelector<HTMLElement>(".image img");
    if (!section || !img) return;

    ScrollTrigger.getAll().forEach((trigger) => {
      if (trigger.vars.trigger === section) trigger.kill();
    });

    gsap.fromTo(
      img,
      { yPercent: -4 },
      {
        yPercent: 4,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      },
    );
  };

  document.addEventListener("astro:page-load", () => {
    animateImage();
    initParallax();
  });
</script>
