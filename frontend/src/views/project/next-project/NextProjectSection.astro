---
import { LinkButton, TextEffectLine } from "../../../components";

const { link } = Astro.props;
---

<section
  id="next-project"
  class="h-screen w-full max-h-200 flex flex-col justify-center items-center relative gap-20"
>
  <div class="flex flex-col justify-center items-center">
    <h1
      class="font-accent text-center font-black -tracking-widest text-main text-[clamp(42px,6vw+1rem,100px)] leading-[75%]"
    >
      <TextEffectLine mixBlend align="left" blockColor="#242424"
        >Next</TextEffectLine
      >
    </h1>
    <h1
      class="text-center font-black -tracking-widest text-main text-[clamp(42px,6vw+1rem,100px)] leading-[75%]"
    >
      <TextEffectLine mixBlend align="left" blockColor="#242424"
        >Project</TextEffectLine
      >
    </h1>
  </div>

  <LinkButton text="View Project" href={link} class="next-project-link">
    <span class="next-project-link__mark" aria-hidden="true">
      <svg class="next-project-link__mark-circle" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="18" />
      </svg>
      <span class="next-project-link__mark-arrow">→</span>
    </span>
  </LinkButton>
</section>

<style is:global>
  a.next-project-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: #fff;
    mix-blend-mode: difference;
  }

  .next-project-link__mark {
    position: relative;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .next-project-link__mark-circle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    overflow: visible;
  }
  .next-project-link__mark-circle circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-dasharray: 113;
    stroke-dashoffset: 113;
    transition: stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .next-project-link:hover .next-project-link__mark-circle circle,
  .next-project-link:focus-visible .next-project-link__mark-circle circle {
    stroke-dashoffset: 0;
  }

  .next-project-link__mark-arrow {
    position: relative;
    font-size: 1.4rem;
    line-height: 1;
    transition: font-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .next-project-link:hover .next-project-link__mark-arrow,
  .next-project-link:focus-visible .next-project-link__mark-arrow {
    font-size: 0.95rem;
  }
</style>
