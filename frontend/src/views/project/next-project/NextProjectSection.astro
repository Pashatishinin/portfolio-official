---
import { LinkButton, TextEffectLine } from "../../../components";

const { link } = Astro.props;
---

<section
  id="next-project"
  class="h-svh w-full max-h-200 flex flex-col justify-center items-center relative gap-10 sm:gap-20"
>
  <div class="flex flex-col justify-center items-center">
    {/* Один заголовок вместо двух h1: строки разнесены визуально,
        но для AT это одна фраза. */}
    <h2 class="sr-only">Next project</h2>
    <div
      class="font-accent text-center font-black -tracking-widest text-main text-[clamp(42px,6vw+1rem,100px)] leading-[75%]"
      aria-hidden="true"
    >
      <TextEffectLine mixBlend align="left" blockColor="#242424"
        >Next</TextEffectLine
      >
    </div>
    <div
      class="text-center font-black -tracking-widest text-main text-[clamp(42px,6vw+1rem,100px)] leading-[75%]"
      aria-hidden="true"
    >
      <TextEffectLine mixBlend align="left" blockColor="#242424"
        >Project</TextEffectLine
      >
    </div>
  </div>

  <LinkButton text="View Project" href={link} class="next-project-link">
    <span class="next-project-link__mark" aria-hidden="true">
      <svg class="next-project-link__mark-circle" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="18"></circle>
      </svg>
      <span class="next-project-link__mark-arrow">→</span>
    </span>
  </LinkButton>
</section>
