---
import { TextEffectLine } from "../../../components";
import PreviewList from "./ui/PreviewList.astro";

interface VideoItem {
  src: string;
  poster: string;
}

interface Props {
  listVideo?: VideoItem[];
  info?: string;
}

const { listVideo = [], info } = Astro.props;
---

{
  listVideo.length > 0 && (
    <section
      id="short-preview"
      class="relative w-full px-4 sm:px-16 pt-8 bg-[#faf6f0]"
    >
      {info && (
        <div class="px-4 sm:px-16 py-8 max-w-480 mx-auto flex flex-col items-center w-full gap-16">
          <div class="max-w-200 about-info-text">
            <span class="text-lg sm:text-xl md:text-2xl lg:text-3xl">
              <TextEffectLine mixBlend align="center" blockColor="#141314">
                {info}
              </TextEffectLine>
            </span>
          </div>
        </div>
      )}
      <div class="relative max-w-480 mx-auto">
        <div class="absolute inset-0 pointer-events-none z-0">
          <div class="sticky top-0 h-screen flex flex-col justify-center p-16">
            <h1 class="font-accent italic text-[90px] sm:text-[160px] md:text-[220px] lg:text-[64px] leading-[65%] -tracking-widest">
              <TextEffectLine blockColor="var(--color-main)">Short</TextEffectLine>
            </h1>
            <h1 class="text-[90px] sm:text-[160px] md:text-[220px] lg:text-[100px] leading-[65%] -tracking-widest">
              <TextEffectLine blockColor="var(--color-main)">Preview</TextEffectLine>
            </h1>
          </div>
        </div>

        {/* Videos on top, provide scroll height */}
        <div class="relative z-10 py-24">
          <PreviewList listVideo={listVideo} />
        </div>
      </div>
    </section>
  )
}

<style>
  img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  p {
    font-size: 18px;
    line-height: 95%;
  }

  .video-blur {
    filter: blur(1px) grayscale(1) brightness(0.5);
    transition: filter 0.3s ease-out;
    will-change: filter;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initVideoBlur = () => {
    const videos = document.querySelectorAll(".video-blur");

    videos.forEach((video) => {
      gsap.to(video, {
        filter: "blur(0px)",
        scrollTrigger: {
          trigger: video,
          start: "top 90%",
          end: "top 20%",
          scrub: true,
          // markers: true,
        },
      });

      gsap.to(video, {
        filter: "blur(10px)",
        scrollTrigger: {
          trigger: "#short-preview",
          start: "bottom 20%",
          end: "bottom 0%",
          scrub: true,
          // markers: true,
        },
      });
    });

    let proxy = { skew: 0 },
      skewSetter = gsap.quickSetter(".video-blur", "skewY", "deg"),
      clamp = gsap.utils.clamp(-2, 2);

    ScrollTrigger.create({
      onUpdate: (self) => {
        let skew = clamp(self.getVelocity() / -1000);

        if (Math.abs(skew) > Math.abs(proxy.skew)) {
          proxy.skew = skew;
          gsap.to(proxy, {
            skew: 0,
            duration: 0.8,
            ease: "power3",
            overwrite: true,
            onUpdate: () => skewSetter(proxy.skew),
          });
        }
      },
    });

    ScrollTrigger.refresh();
  };

  document.addEventListener("astro:page-load", initVideoBlur);
</script>
