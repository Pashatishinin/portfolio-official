---
import { TextEffectLine } from "../../../components";
import PreviewList from "./ui/PreviewList.astro";

interface VideoItem {
  src: string | null;
  poster: string;
}

interface Props {
  listVideo?: VideoItem[];
  info?: string;
}

const { listVideo = [], info } = Astro.props;
---

{
  listVideo.length > 0 && (
    <section
      id="short-preview"
      class="relative w-full px-4 sm:px-16 pt-8 bg-[#faf6f0]"
    >
      {info && (
        <div class=" py-8 max-w-480 mx-auto flex flex-col items-center w-full gap-8 sm:gap-16">
          <div class="max-w-200 about-info-text">
            <span class="text-lg sm:text-xl md:text-2xl lg:text-3xl">
              <TextEffectLine mixBlend align="center" blockColor="#141314">
                {info}
              </TextEffectLine>
            </span>
          </div>
        </div>
      )}
      <div class="relative max-w-480 mx-auto">
        {/* Below lg (<1024px): normal, non-sticky block in-flow above
            the videos, centered — the absolute/sticky overlay used to
            overlap the video grid at those widths. lg+ (≥1024px):
            flips back to the original absolute background overlay,
            pinned behind the videos while scrolling. DOM position
            (before the video list) already puts it above once it's no
            longer taken out of flow by position:absolute. */}
        <div class="lg:absolute lg:inset-0 lg:pointer-events-none lg:z-0">
          <div class="flex flex-col items-center text-center p-4 sm:p-8 lg:p-16 lg:sticky lg:top-0 lg:h-svh lg:justify-center lg:items-start lg:text-left">
            <h1 class="font-accent italic text-[clamp(40px,8vw,220px)] leading-[65%] -tracking-widest">
              <TextEffectLine blockColor="var(--color-main)">
                Short
              </TextEffectLine>
            </h1>
            <h1 class="text-[clamp(48px,10vw,220px)] leading-[65%] -tracking-widest -mt-[0.15em] lg:mt-0">
              <TextEffectLine blockColor="var(--color-main)">
                Preview
              </TextEffectLine>
            </h1>
          </div>
        </div>

        {/* Videos on top, provide scroll height */}
        <div class="relative z-10 pb-24 lg:py-24">
          <PreviewList listVideo={listVideo} />
        </div>
      </div>
    </section>
  )
}

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initVideoBlur = () => {
    const videos = document.querySelectorAll(".video-blur");

    videos.forEach((video) => {
      gsap.to(video, {
        filter: "blur(0px)",
        scrollTrigger: {
          trigger: video,
          start: "top 90%",
          end: "top 20%",
          scrub: true,
          // markers: true,
        },
      });

      gsap.to(video, {
        filter: "blur(10px)",
        scrollTrigger: {
          trigger: "#short-preview",
          start: "bottom 20%",
          end: "bottom 0%",
          scrub: true,
          // markers: true,
        },
      });
    });

    let proxy = { skew: 0 },
      skewSetter = gsap.quickSetter(".video-blur", "skewY", "deg"),
      clamp = gsap.utils.clamp(-2, 2);

    ScrollTrigger.create({
      onUpdate: (self) => {
        let skew = clamp(self.getVelocity() / -1000);

        if (Math.abs(skew) > Math.abs(proxy.skew)) {
          proxy.skew = skew;
          gsap.to(proxy, {
            skew: 0,
            duration: 0.8,
            ease: "power3",
            overwrite: true,
            onUpdate: () => skewSetter(proxy.skew),
          });
        }
      },
    });

    ScrollTrigger.refresh();
  };

  document.addEventListener("astro:page-load", initVideoBlur);
</script>
