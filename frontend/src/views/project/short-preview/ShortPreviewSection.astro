---
import { TextEffectLine } from "../../../components";
import PreviewList from "./ui/PreviewList.astro";

interface VideoItem {
  src: string;
  poster: string;
}

interface Props {
  listVideo?: VideoItem[];
}

const { listVideo = [] } = Astro.props;
---

<section class="relative w-full px-4 sm:px-16 pt-8 max-w-480 mx-auto">
  <!-- h-0 trick: sticky but takes no flow space — videos scroll over it -->
  <div class="sticky top-0 h-50 sm:h-100 pointer-events-none z-0">
    <div class="opacity-10">
      <h1
        class="font-accent italic text-[90px] sm:text-[160px] md:text-[220px] lg:text-[300px] leading-[65%] -tracking-widest"
      >
        <TextEffectLine blockColor="var(--color-main)">Short</TextEffectLine>
      </h1>
      <h1
        class="text-[90px] sm:text-[160px] md:text-[220px] lg:text-[300px] leading-[65%] -tracking-widest"
      >
        <TextEffectLine blockColor="var(--color-main)">Preview</TextEffectLine>
      </h1>
    </div>
  </div>

  <!-- Videos on top, provide scroll height -->
  <div class="relative z-10 py-24">
    <PreviewList listVideo={listVideo} />
  </div>
</section>

<style>
  img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  p {
    font-size: 18px;
    line-height: 95%;
  }

  .video-blur {
    filter: blur(1px) grayscale(1) brightness(0.5);
    transition: filter 0.3s ease-out;
    will-change: filter;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initVideoBlur = () => {
    const videos = document.querySelectorAll(".video-blur");

    videos.forEach((video) => {
      gsap.to(video, {
        filter: "blur(0px)",
        scrollTrigger: {
          trigger: video,
          start: "top 90%",
          end: "top 20%",
          scrub: true,
          // markers: true,
        },
      });

      gsap.to(video, {
        filter: "blur(10px)",
        scrollTrigger: {
          trigger: video,
          start: "bottom 20%",
          end: "bottom 0%",
          scrub: true,
        },
      });
    });

    let proxy = { skew: 0 },
      skewSetter = gsap.quickSetter(".video-blur", "skewY", "deg"),
      clamp = gsap.utils.clamp(-2, 2);

    ScrollTrigger.create({
      onUpdate: (self) => {
        let skew = clamp(self.getVelocity() / -1000);

        if (Math.abs(skew) > Math.abs(proxy.skew)) {
          proxy.skew = skew;
          gsap.to(proxy, {
            skew: 0,
            duration: 0.8,
            ease: "power3",
            overwrite: true,
            onUpdate: () => skewSetter(proxy.skew),
          });
        }
      },
    });

    ScrollTrigger.refresh();
  };

  window.addEventListener("load", initVideoBlur);
  document.addEventListener("astro:page-load", initVideoBlur);
</script>
