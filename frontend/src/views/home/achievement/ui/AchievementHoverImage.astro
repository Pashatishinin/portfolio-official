---

---

<div id="achievement-hover-wrap">
  <canvas id="achievement-hover-canvas"></canvas>
</div>

<script>
  import * as THREE from "three";
  import { vertexShader, fragmentShader } from "../shader";

  /**
   * Превью-картинка ездит за курсором — на тач-устройстве появиться
   * не может в принципе. Список достижений при этом остаётся полным:
   * это текст, картинка была только дополнением, так что ничего
   * не теряется. Экономим WebGL-контекст и импорт three на мобильных.
   */
  const CAN_HOVER_FX =
    window.matchMedia("(min-width: 1024px) and (hover: hover)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function init() {
    if (!CAN_HOVER_FX) return;

    const wrap = document.getElementById(
      "achievement-hover-wrap",
    ) as HTMLDivElement;
    const canvas = document.getElementById(
      "achievement-hover-canvas",
    ) as HTMLCanvasElement;
    if (!canvas || !wrap || canvas.dataset.init) return;
    canvas.dataset.init = "true";

    const W = 360;
    const H = 200;
    canvas.width = W;
    canvas.height = H;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: false });
    renderer.setClearColor(0x0d0d0d, 1);
    renderer.setSize(W, H);

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const emptyTex = new THREE.DataTexture(
      new Uint8Array([13, 13, 13, 255]),
      1,
      1,
      THREE.RGBAFormat,
    );
    emptyTex.needsUpdate = true;

    const mat = new THREE.ShaderMaterial({
      uniforms: {
        uTexCurrent: { value: emptyTex },
        uTexNext: { value: emptyTex },
        uProgress: { value: 0 },
        uResolution: { value: new THREE.Vector2(W, H) },
        uImageRes: { value: new THREE.Vector2(1, 1) },
        uWaveFreq: { value: 18.0 },
        uWavePow: { value: 0.01 },
        uWaveWidth: { value: 0.55 },
        uFalloff: { value: 6.0 },
        uBoostStrength: { value: 0.2 },
        uCrossfadeWidth: { value: 0.18 },
        uMobile: { value: 1.0 },
      },
      vertexShader,
      fragmentShader,
      transparent: false,
    });

    const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), mat);
    scene.add(quad);

    const loader = new THREE.TextureLoader();
    loader.setCrossOrigin("anonymous");
    const texCache = new Map<string, THREE.Texture>();

    let active = false;
    let prog = 0;
    let lastTex: THREE.Texture = emptyTex;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    const SPEED = 0.022;
    const MAX_PROG = 0.88;

    function startShow(src: string) {
      const tex = texCache.get(src) ?? emptyTex;
      mat.uniforms.uTexCurrent.value = active && prog > 0.05 ? lastTex : tex;
      mat.uniforms.uTexNext.value = tex;
      if (tex !== emptyTex && tex.image) {
        const { width, height } = tex.image as {
          width: number;
          height: number;
        };
        mat.uniforms.uImageRes.value.set(width, height);
      }
      prog = 0;
      mat.uniforms.uProgress.value = 0;
      lastTex = tex;
      active = true;
      wrap.style.opacity = "1";
    }

    function onEnter(src: string) {
      if (hideTimer) {
        clearTimeout(hideTimer);
        hideTimer = null;
      }
      startShow(src);
    }

    function onLeave() {
      hideTimer = setTimeout(() => {
        active = false;
        prog = 0;
        mat.uniforms.uProgress.value = 0;
        wrap.style.opacity = "0";
        hideTimer = null;
      }, 60);
    }

    function loop() {
      requestAnimationFrame(loop);

      if (active && prog < MAX_PROG) {
        prog = Math.min(MAX_PROG, prog + SPEED);
        mat.uniforms.uProgress.value = prog;
      }

      renderer.render(scene, camera);
    }
    loop();

    document.addEventListener("mousemove", (e) => {
      wrap.style.left = e.clientX + "px";
      wrap.style.top = e.clientY + "px";
    });

    function setup() {
      document
        .querySelectorAll<HTMLElement>("[data-achievement-img]")
        .forEach((el) => {
          const src = el.dataset.achievementImg!;

          if (src && !texCache.has(src)) {
            loader.load(src, (tex) => {
              tex.minFilter = THREE.LinearFilter;
              tex.generateMipmaps = false;
              texCache.set(src, tex);
            });
          }

          if (el.dataset.hoverBound) return;
          el.dataset.hoverBound = "true";
          el.addEventListener("mouseenter", () => onEnter(src));
          el.addEventListener("mouseleave", onLeave);
        });
    }

    setup();

    const achCanvas = document.getElementById(
      "achievement-hover-canvas",
    ) as HTMLCanvasElement;
    if (achCanvas)
      (achCanvas as any).__dispose = () => {
        renderer.dispose();
        delete (achCanvas as any).__dispose;
      };

    document.addEventListener(
      "astro:before-swap",
      () => {
        renderer.dispose();
        if (achCanvas) delete (achCanvas as any).__dispose;
      },
      { once: true },
    );
  }

  function onReady(fn: () => void) {
    if (document.readyState === "complete") fn();
    else window.addEventListener("load", fn);
  }

  onReady(init);
  document.addEventListener("astro:after-swap", init);
</script>
