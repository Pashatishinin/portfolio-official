---
interface Props {
  award: string;
  result: string;
  year?: string | null;
  img?: string | null;
}

const { award, result, year, img } = Astro.props;
---

<div
  class="achievement-row grid grid-cols-2 sm:grid-cols-3 md:px-8 py-2 sm:py-4 lg:py-8 border-b border-main/20 items-start sm:items-center hover:bg-main/20 transition-colors group gap-y-2 gap-x-4 sm:gap-0"
  data-achievement-img={img}
>
  <p
    class="col-span-2 sm:col-span-1 text-left sm:text-right font-mono text-xs sm:text-sm opacity-50 sm:opacity-100 order-1 sm:order-3"
  >
    {year}
  </p>

  <p
    class="font-bold font-accent -tracking-widest text-2xl sm:text-3xl md:text-4xl lg:text-[48px] leading-tight order-2 sm:order-1"
  >
    {award}
  </p>

  <p
    class="text-right sm:text-center text-sm sm:text-base md:text-lg opacity-70 group-hover:opacity-100 transition-opacity order-3 sm:order-2"
  >
    {result}
  </p>
</div>
