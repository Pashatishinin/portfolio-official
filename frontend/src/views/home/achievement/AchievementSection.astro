---
import { TextEffectLine } from "../../../components";
import { getAchievements } from "../../../shared/api/home.api";
import AchievementHoverImage from "./ui/AchievementHoverImage.astro";
import AchievementItem from "./ui/AchievementItem.astro";

const achievements = await getAchievements();
---

<section
  id="achievement"
  class="relative w-full p-4 md:p-16 grid grid-cols-1 gap-12 lg:gap-20 max-w-[1920px] mx-auto mix-blend-difference"
>
  <div class="flex flex-col w-full text-lg md:text-2xl text-main">
    {
      achievements.map((item, i) => (
        <AchievementItem
          {...item}
          year={item.year !== achievements[i - 1]?.year ? item.year : null}
        />
      ))
    }
  </div>
</section>

<div class="hidden sm:block opacity-95">
  <AchievementHoverImage />
</div>
