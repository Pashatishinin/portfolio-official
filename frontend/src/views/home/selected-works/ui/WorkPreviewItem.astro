---
import FluidOverlay from "../../../../components/animation/FluidOverlay.astro";

interface Props {
  poster?: string | null;
  link?: string;
}

const { poster, link } = Astro.props;
const posterSrc = poster ?? "/1.avif";
---

<div
  class="relative w-full aspect-video opacity-[0.5] transition-all duration-300 ease-in overflow-hidden"
>
  <a href={link} class="absolute inset-0 z-10 pointer-events-auto"></a>

  <FluidOverlay image={posterSrc} />
</div>
