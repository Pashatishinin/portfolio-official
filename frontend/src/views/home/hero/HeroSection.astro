---
import { TextEffect } from "../../../components";
import { getHeroContent } from "../../../shared/api/home.api";

const {
  firstName: nameLine1,
  lastName: nameLine2,
  taglineLine1,
  taglineLine2,
} = await getHeroContent();
---

<section
  id="hero"
  class="relative z-10 h-full max-h-250 min-h-svh w-full max-w-[1920px] mx-auto"
>
  <div
    class="px-8 sm:px-16 py-16 gap-12 justify-center sm:py-32 sm:gap-0 sm:justify-between 2xl:py-54 flex flex-col min-h-svh h-full text-background"
  >
    {/* Единственный h1 страницы. Раньше каждая из четырёх строк была
        отдельным h1 — скринридер объявлял четыре заголовка первого
        уровня и не понимал, где начинается документ. Теперь заголовок
        один и текстовый, а крупные строки — обычные div: TextEffect
        рвёт их на символы, и в доступном дереве им делать нечего
        (aria-label на div без роли всё равно игнорируется). */}
    <h1 class="sr-only">
      {nameLine1}
      {nameLine2} — {taglineLine1}
      {taglineLine2}
    </h1>

    <div aria-hidden="true">
      <div
        class="font-accent text-right font-black -tracking-widest text-[clamp(48px,10vw,210px)] leading-[75%]"
      >
        <TextEffect delay={0.2} wait>{taglineLine1} </TextEffect>
      </div>
      <div
        class="text-right font-black -tracking-[0.06em] text-[clamp(48px,10vw,192px)] leading-[75%]"
      >
        <TextEffect delay={0.2} wait>{taglineLine2}</TextEffect>
      </div>
    </div>

    <div aria-hidden="true">
      <div
        class="font-accent text-left font-bold -tracking-widest text-[clamp(48px,10vw,210px)] leading-[75%]"
      >
        <TextEffect delay={0.2} wait>{nameLine1}</TextEffect>
      </div>
      <div
        class="text-left font-black -tracking-[0.06em] text-[clamp(48px,10vw,192px)] leading-[75%]"
      >
        <TextEffect delay={0.2} wait>{nameLine2}</TextEffect>
      </div>
    </div>
    <div class="hint">scroll down ↓</div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Fixed 800x800 (set in Object3D.astro) read the same on every screen,
  // so the object looked small/low on large monitors — scale the box
  // with the viewport instead. Applied as inline !important styles
  // because Object3D.astro's own scoped !important rule otherwise wins.
  const applyResponsiveCrystalBox = () => {
    const el = document.querySelector<HTMLElement>("body > three-crystal");
    if (!el) return;

    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const vmin = Math.min(vw, vh);
    const size = Math.min(Math.max(vmin * 0.84, 420), 1950);
    el.style.setProperty("width", `${size}px`, "important");
    el.style.setProperty("height", `${size}px`, "important");

    // The scroll-driven tween below animates top/left/xPercent/yPercent
    // (never bottom/right), so the resting position is expressed in the
    // same properties here — mixing bottom/right for rest with top/left
    // for the scrubbed state made GSAP jump instead of interpolate the
    // moment scroll started, and it got more visible once the object
    // grew bigger. topPx/leftPx bake the current `size` in so the corner
    // position is stable regardless of viewport aspect ratio.
    const jellyTrigger = ScrollTrigger.getById("jelly-scroll");
    if (jellyTrigger && jellyTrigger.progress > 0) return;

    // const bottomPct = vw >= 2200 ? 0 : vw >= 1600 ? -4 : -16;
    // const rightPct = vw >= 1600 ? 6 : 8;
    let bottomPct: number;
    let rightPct: number;

    if (vw >= 2200) {
      // Ultra-wide
      bottomPct = 0;
      rightPct = 2;
    } else if (vw >= 1600) {
      // Large Desktop
      bottomPct = -4;
      rightPct = 3;
    } else if (vw >= 1024) {
      // Desktop / Laptop
      bottomPct = -8;
      rightPct = 3;
    } else if (vw >= 768) {
      // Tablets
      bottomPct = -12;
      rightPct = 2;
    } else {
      // Mobile (< 768px) — опускаем ниже или центрируем при необходимости
      bottomPct = -18;
      rightPct = -5;
    }
    const topPx = vh * (1 - bottomPct / 100) - size;
    const leftPx = vw * (1 - rightPct / 100) - size;

    el.style.setProperty("top", `${(topPx / vh) * 100}%`, "important");
    el.style.setProperty("left", `${(leftPx / vw) * 100}%`, "important");
    el.style.setProperty("bottom", "auto", "important");
    el.style.setProperty("right", "auto", "important");
  };
  // Exposed so PreviewSection.astro can restore the resting hero size
  // when scrolling back out of #preview, without duplicating the formula.
  (window as any).initHeroCrystalBox = applyResponsiveCrystalBox;

  const initHero = () => {
    const oldJellyTrigger = ScrollTrigger.getById("jelly-scroll");
    if (oldJellyTrigger) oldJellyTrigger.kill();

    applyResponsiveCrystalBox();
    window.addEventListener("resize", applyResponsiveCrystalBox);

    gsap.set("body > three-crystal", {
      rotation: -45,
      opacity: 0,
      scale: 0,
      xPercent: 0,
      yPercent: 0,
    });

    // HERO_DELAY (Layout.astro) сигналит, ждём ли ещё прелоадер: 3.6 —
    // первая загрузка/reload (прелоадер показывается), 0.2 — обычный
    // переход между страницами (прелоадера нет вообще). Без прелоадера
    // объект должен появляться сразу и быстро, а не через долгую паузу,
    // рассчитанную на время анимации прелоадера.
    const hasPreloader = ((window as any).HERO_DELAY ?? 0.2) > 1;

    const introTl = gsap.timeline();

    introTl.to("body > three-crystal", {
      opacity: 0.5,
      scale: 1,
      duration: hasPreloader ? 1.8 : 0.9,
      ease: "power3.out",
      delay: hasPreloader ? 4 : 0.3,
    });

    gsap.to("body > three-crystal", {
      top: "50%",
      left: "50%",
      xPercent: -50,
      yPercent: -50,
      rotation: 0,
      scrollTrigger: {
        id: "jelly-scroll",
        trigger: "#hero",
        start: "top top",
        end: "bottom top",
        scrub: 1.8,
        invalidateOnRefresh: true,
      },
    });

    ScrollTrigger.refresh();
  };

  document.addEventListener("astro:page-load", initHero);
</script>
<style>
  .hint {
    position: absolute;
    left: 50%;
    bottom: 4rem;
    /* Центрируем элемент с помощью translate */
    transform: translate(-50%, 0);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* было #8b8880 — 2.4:1 на градиенте, при кегле 11px это провал
       1.4.3. #66635c даёт 4.87:1 на самом светлом участке фона. */
    color: #66635c;
    animation: bob 2.4s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      /* Сохраняем -50% по оси X в анимации, чтобы центрирование не сбрасывалось */
      transform: translate(-50%, 0);
      opacity: 0.6;
    }
    50% {
      transform: translate(-50%, 5px);
      opacity: 1;
    }
  }

  @media (min-width: 640px) {
    .hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint {
      animation: none;
    }
  }
</style>
