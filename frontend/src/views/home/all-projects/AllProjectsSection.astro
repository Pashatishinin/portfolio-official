---
import { CtaButton } from "../../../components";

const data = [
    {
        img: "/tokiai.jpg",
        title: "Toki AI",
        topic: "fullstack",
        link: "https://www.tokiai.app/",
        desc: "This is a full-stack, AI-powered app built to solve the biggest hurdle in language learning: the fear of speaking. I developed both the frontend and backend, creating an interactive environment where users can practice real-world scenarios. The AI acts as a natural conversation partner, correcting mistakes instantly and building vocabulary on the fly.",
    },
    {
        img: "/ahin-cover.jpg",
        title: "Ahin Anburaja",
        topic: "website",
        link: "https://www.ahinanburaja.com/",
        desc: "This is a highly creative portfolio website designed for a Product Manager with a background in vibrant, high-impact projects. I focused on building a unique, visually dynamic interface that breaks the mold of traditional resumes to showcase their career highlights in the most engaging way possible.",
    },
    {
        img: "/oliver.jpg",
        title: "Oliver McKenzie",
        topic: "website",
        link: "https://olivermckenzie.onrender.com/",
        desc: "This is a minimalist portfolio website built for a sportswear designer specializing in racing gear. I developed a clean, high-end digital space that reflects the sleek aesthetic of motorsport and puts the spotlight entirely on the unique, high-performance apparel designs.",
    },
    {
        img: "/bentezhne.jpg",
        title: "Ben Tezhne",
        topic: "design",
        desc: "This case is a vibrant brand identity project created for a craft beverage line. Inspired by pop art culture, I designed a bold visual system using striking colors and expressive typography to give the product a standout, energetic, and modern presence on the shelf.",
        behance:
            "https://www.behance.net/gallery/242388337/Ben-Tezhne-Brand-Idendity",
    },
    {
        img: "/dagharo.jpg",
        title: "Fredrick Dagharo",
        topic: "website",
        link: "https://www.fredrickdagharo.com/",
        desc: "This is a sleek portfolio website designed for a creative filmmaker to showcase their video work. I developed a high-performance, visually engaging platform that allows seamless video playback and puts their creative showreels front and center.",
    },
    {
        img: "/vettar-cover.jpg",
        title: "Vettar",
        topic: "website",
        link: "https://www.vettar.ua",
        desc: "Modernity, convenience, and trust are the three key principles I implemented in the new design of VETTAR. My goal was not just to update the interface, but to create an emotional connection with the user. I made the site more intuitive, added blocks about the company and products to emphasize the openness of the brand and inspire trust.",
    },
    {
        img: "/benjamin-cover.jpg",
        title: "8enjamin",
        topic: "website",
        link: "https://8enjamin.vercel.app/",
        desc: "This project is a showcase of one clothing designer, where the style and work of the designer are conveyed as much as possible. The main goal of the project was to create a space where visitors could learn more about the designer and his works and go to the store to buy his works.",
    },
    {
        img: "/blive-cover.jpg",
        title: "Blive Coaching",
        topic: "website",
        link: "https://be-live-coaching.vercel.app",
        desc: "This is a welcoming website designed for a mental health coach. To create a safe and soothing atmosphere for visitors, I used a soft, pastel color palette and a clean layout. The platform is structured to thoroughly introduce the coach’s personality, build trust, and clearly communicate their diverse coaching methodologies.",
    },
];

const leftItems = data.slice(0, 4);
const rightItems = data.slice(4);

const filters = [
    { label: "All Projects", value: "all" },
    { label: "Full-Stack Apps", value: "fullstack" },
    { label: "Websites & CMS", value: "website" },
    { label: "Brand Design", value: "design" },
];
---

<section
    id="all-projects"
    class="relative w-screen px-4 sm:px-16 max-w-[1920px] mx-auto min-h-screen pt-16 mb-32"
>
    <div
        class="grid grid-cols-4 lg:grid-cols-5 gap-4 items-start pt-16 lg:pt-0"
    >
        <div class="col-span-2 flex flex-col gap-4">
            {
                leftItems.map((item) => (
                    <div class="project-card w-full" data-topic={item.topic}>
                        <div class="relative w-full aspect-video bg-main overflow-hidden">
                            <img
                                src={item.img}
                                alt={item.title}
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                        </div>
                        <div class="pt-2 flex flex-col gap-4">
                            <div>
                                <p class="text-base font-black">{item.title}</p>
                                <p class="text-sm tracking-wide opacity-50">
                                    {item.desc}
                                </p>
                            </div>
                            <div class="z-30">
                                {item.link && (
                                    <CtaButton
                                        text="Visit Site"
                                        link={item.link}
                                    />
                                )}
                                {item.behance && (
                                    <CtaButton
                                        text="View Case"
                                        link={item.behance}
                                    />
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="hidden lg:col-span-1 lg:block"></div>

        <div class="col-span-2 flex flex-col gap-4">
            {
                rightItems.map((item) => (
                    <div class="project-card w-full" data-topic={item.topic}>
                        <div class="relative w-full aspect-video bg-main overflow-hidden">
                            <img
                                src={item.img}
                                alt={item.title}
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                        </div>
                        <div class="pt-2 flex flex-col gap-4">
                            <div>
                                <p class="text-base font-black">{item.title}</p>
                                <p class="text-sm tracking-wide opacity-50">
                                    {item.desc}
                                </p>
                            </div>
                            <div class="z-30">
                                {item.link && (
                                    <CtaButton
                                        text="Visit Site"
                                        link={item.link}
                                    />
                                )}
                                {item.behance && (
                                    <CtaButton
                                        text="View Case"
                                        link={item.behance}
                                    />
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <div class="absolute inset-0 pointer-events-none">
        <ul
            id="project-filters"
            class="flex flex-col mix-blend-difference text-center pointer-events-none sticky top-20 lg:top-0 translate-y-1/2 w-fit mx-auto"
        >
            {
                filters.map((f, i) => (
                    <li
                        class:list={[
                            "filter-item cursor-pointer pointer-events-auto  h-full ",
                            { "opacity-100": i === 0, "opacity-30": i !== 0 },
                        ]}
                        data-filter={f.value}
                    >
                        <div class="filter-label-container overflow-hidden relative text-center">
                            <p class="filter-label-text m-0 font-black text-[clamp(20px,4vw,80px)] -tracking-widest font-accent text-white leading-[95%] ">
                                {f.label}
                            </p>
                            <p class="filter-label-text m-0 font-black text-[clamp(20px,4vw,80px)] -tracking-widest font-accent text-white leading-[95%] absolute top-0 left-0 w-full opacity-0">
                                {f.label}
                            </p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger, SplitText);

    const animateIn = (els: HTMLElement[], delay = 0) => {
        gsap.fromTo(
            els,
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.5,
                stagger: 0.07,
                ease: "power2.out",
                delay,
            },
        );
    };

    let sectionST: ScrollTrigger | null = null;

    const cleanup = () => {
        sectionST?.kill();
        sectionST = null;
    };

    const init = () => {
        cleanup();

        const section = document.querySelector<HTMLElement>("#all-projects");
        const filterBtns = document.querySelectorAll<HTMLElement>(
            "#project-filters .filter-item",
        );
        const cards = document.querySelectorAll<HTMLElement>(".project-card");

        if (!section) return;

        gsap.set(cards, { opacity: 0, y: 16 });

        type LabelSplit = {
            split1: InstanceType<typeof SplitText>;
            split2: InstanceType<typeof SplitText>;
        };
        const labelSplits: LabelSplit[] = [];

        filterBtns.forEach((btn) => {
            const texts =
                btn.querySelectorAll<HTMLElement>(".filter-label-text");
            if (texts.length < 2) return;

            const split1 = new SplitText(texts[0], { type: "chars" });
            const split2 = new SplitText(texts[1], { type: "chars" });

            gsap.set(split1.chars, { yPercent: 110 });
            gsap.set(texts[1], { opacity: 1 });
            gsap.set(split2.chars, { yPercent: 110 });

            labelSplits.push({ split1, split2 });

            const hoverTl = gsap.timeline({ paused: true });
            hoverTl
                .to(split1.chars, {
                    yPercent: -110,
                    stagger: 0.02,
                    duration: 0.4,
                    ease: "power2.inOut",
                })
                .to(
                    split2.chars,
                    {
                        yPercent: 0,
                        stagger: 0.02,
                        duration: 0.4,
                        ease: "power2.inOut",
                    },
                    "<",
                );

            btn.addEventListener("mouseenter", () => hoverTl.play());
            btn.addEventListener("mouseleave", () => hoverTl.reverse());
        });

        sectionST = ScrollTrigger.create({
            trigger: section,
            start: "top 80%",
            once: true,
            onEnter: () => {
                animateIn([...cards] as HTMLElement[]);

                labelSplits.forEach(({ split1 }, i) => {
                    gsap.to(split1.chars, {
                        yPercent: 0,
                        stagger: 0.01,
                        duration: 0.8,
                        ease: "power3.out",
                        delay: i * 0.12,
                    });
                });
            },
        });

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const active = btn.dataset.filter!;

                filterBtns.forEach((f) => {
                    f.classList.toggle("opacity-100", f === btn);
                    f.classList.toggle("opacity-30", f !== btn);
                });

                const matching = [...cards].filter(
                    (c) =>
                        active === "all" ||
                        (c as HTMLElement).dataset.topic === active,
                ) as HTMLElement[];
                const dimmed = [...cards].filter(
                    (c) =>
                        active !== "all" &&
                        (c as HTMLElement).dataset.topic !== active,
                ) as HTMLElement[];

                gsap.to(matching, {
                    filter: "grayscale(0) blur(0px)",
                    opacity: 1,
                    duration: 0.5,
                    ease: "power2.out",
                });

                gsap.to(dimmed, {
                    filter: "grayscale(1) blur(3px)",
                    opacity: 0.25,
                    duration: 0.5,
                    ease: "power2.out",
                });
            });
        });
    };

    document.addEventListener("astro:before-preparation", cleanup);
    document.addEventListener("astro:page-load", init);
</script>
