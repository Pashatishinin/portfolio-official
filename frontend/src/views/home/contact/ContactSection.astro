---
import { milestoneRows } from "../../../shared/data/milestones.data";

const REPEAT_COUNT = 1;
const rows = Array.from({ length: REPEAT_COUNT }, () => milestoneRows).flat();
---

<section id="contact" class="contact-section relative w-full text-secondary">
  <div
    class="contact-visual relative w-full h-[25svh] pt-16 flex justify-center items-center overflow-hidden"
  >
    <h2 class="contact-info-row flex justify-center items-baseline">
      <span
        class="contact-info-cell text-right font-accent font-black -tracking-widest text-black text-[clamp(40px,8vw,130px)] leading-[90%] will-change-transform"
      >Miles</span
      ><span
        class="contact-info-cell text-left font-accent font-black -tracking-widest text-black text-[clamp(40px,8vw,130px)] leading-[90%] will-change-transform"
      >tones</span
      >
    </h2>
  </div>

  <div
    class="contact-info flex flex-col justify-center gap-6 py-32 overflow-hidden"
  >
    {
      rows.map((row) => (
        <a
          href={row.link}
          class="name-roll-trigger contact-info-row flex justify-center items-center gap-4"
        >
          <p class="contact-info-cell flex-1 text-right text-xl sm:text-3xl leading-[0.95] -tracking-[0.025rem] text-black will-change-transform">
            {(() => {
              const [name, ...rest] = row.title.split(" — ");
              const role = rest.join(" — ");
              // Тот же приём "прокрутки" текста, что у AnimatedLink.astro
              // (Logo) — два наложенных слоя текста, посимвольно уезжающих
              // при ховере. Размеры в em (не px, как в AnimatedLink), чтобы
              // подстраивались под текущий font-size этого заголовка.
              const nameEl = (
                <span class="name-roll-container relative inline-block overflow-hidden align-bottom h-[1.25em]">
                  <span class="name-roll-text block leading-[1.25em]">
                    {name}
                  </span>
                  <span class="name-roll-text absolute top-0 left-0 block w-full leading-[1.25em] opacity-0">
                    {name}
                  </span>
                </span>
              );
              return role
                ? [nameEl, <br />, <span class="text-[0.6em]">{role}</span>]
                : [nameEl];
            })()}
          </p>
          <p class="contact-info-cell font-accent flex-1 text-lg sm:text-2xl leading-[0.95] -tracking-[0.025rem] text-[#4f4f4f] will-change-transform">
            <span class="inline-block max-w-100">{row.description}</span>
          </p>
        </a>
      ))
    }
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // Тот же приём, что в AnimatedLink.astro (Logo): по ховеру символы
  // текущего текста уезжают вверх посимвольно, а под ними снизу
  // "въезжает" его дубликат.
  const initNameRollHover = () => {
    const triggersEls = document.querySelectorAll("#contact .name-roll-trigger");

    triggersEls.forEach((trigger) => {
      if (trigger.getAttribute("data-animated")) return;

      const texts = trigger.querySelectorAll(".name-roll-text");
      if (texts.length < 2) return;

      const [firstText, secondText] = texts;
      const split1 = new SplitText(firstText, { type: "chars" });
      const split2 = new SplitText(secondText, { type: "chars" });

      gsap.set(secondText, { opacity: 1 });
      gsap.set(split2.chars, { yPercent: 100 });

      const tl = gsap.timeline({ paused: true });

      tl.to(split1.chars, {
        yPercent: -100,
        stagger: 0.02,
        duration: 0.4,
        ease: "power2.inOut",
      }).to(
        split2.chars,
        { yPercent: 0, stagger: 0.02, duration: 0.4, ease: "power2.inOut" },
        "<",
      );

      trigger.addEventListener("mouseenter", () => tl.play());
      trigger.addEventListener("mouseleave", () => tl.reverse());

      trigger.setAttribute("data-animated", "true");
    });
  };

  let triggers: ScrollTrigger[] = [];

  const initContactAnimation = () => {
    triggers.forEach((trigger) => trigger.kill());
    triggers = [];

    const section = document.querySelector("#contact");
    const rows = document.querySelectorAll("#contact .contact-info-row");
    if (!section || rows.length === 0) return;

    const maxGap = window.innerWidth < 1000 ? 15 : 20;

    // three-crystal теперь один общий инстанс на весь сайт (Layout.astro),
    // видимый непрерывно от Hero и дальше — не скрываем его тут: раньше
    // это была ОТДЕЛЬНАЯ копия, скрытая по умолчанию и включаемая только
    // в #contact, но на общем инстансе такое скрытие ничем не отменяется
    // при уходе из #contact, и объект пропадает навсегда для верхних секций.
    triggers.push(
      ScrollTrigger.create({
        trigger: section,
        start: "top bottom",
        end: "bottom top",
        onToggle: (self) =>
          section.classList.toggle("is-active", self.isActive),
      }),
    );

    // "body > three-crystal", а не просто "three-crystal" — на странице
    // есть ещё отдельный инстанс внутри PreLoader.astro, его трогать не надо.
    const crystal = document.querySelector<HTMLElement>("body > three-crystal");
    if (crystal) {
      // Позицию и поворот больше не трогаем — объект остаётся там же, где
      // его оставил jelly-scroll в Hero. На протяжении всей секции плавно
      // уменьшается до 0 к её концу. Three.js-уровень, тот же target,
      // что и у CrystalController.
      const scaleTween = gsap.to((crystal as any).target, {
        scale: 0,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      });
      if (scaleTween.scrollTrigger) triggers.push(scaleTween.scrollTrigger);
    }

    rows.forEach((row) => {
      const cells = row.querySelectorAll<HTMLElement>(".contact-info-cell");
      const [label, value] = cells;
      if (!label || !value) return;

      // Pushes the label/value apart from the row's center — translate only,
      // so layout height never changes and later triggers can't drift.
      const setOffset = (offsetRem: number) => {
        label.style.transform = `translateX(-${offsetRem}rem)`;
        value.style.transform = `translateX(${offsetRem}rem)`;
      };

      // "center center" — точка отсчёта считается GSAP от фактической
      // геометрии строки (row), а не от фиксированного пикселя из "top";
      // работает одинаково независимо от того, в одну строку текст или
      // перенёсся на две.
      triggers.push(
        ScrollTrigger.create({
          trigger: row,
          start: "40% center+=100",
          end: "80% center",
          scrub: true,
          // markers: true,
          onUpdate: (self) => setOffset((maxGap / 2) * self.progress),
        }),
      );

      // Небольшой зазор (-=50) перед стартом схождения — слово чуть
      // дольше держится в разведённом состоянии перед тем как вернуться.
      triggers.push(
        ScrollTrigger.create({
          trigger: row,
          start: "center center-=50",
          end: "center center-=150",
          scrub: true,
          onUpdate: (self) => setOffset((maxGap / 2) * (1 - self.progress)),
        }),
      );
    });

    initNameRollHover();
  };

  document.addEventListener("astro:page-load", initContactAnimation);
  document.addEventListener("astro:before-preparation", () => {
    triggers.forEach((trigger) => trigger.kill());
    triggers = [];
  });
</script>
