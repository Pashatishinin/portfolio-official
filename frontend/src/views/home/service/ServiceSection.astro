---
import { TextEffectLine } from "../../../components";
---

<section class="min-h-screen p-16">
  <div>
    <h1 class="font-accent italic text-5xl md:text-6xl text-main leading-[75%]">
      <TextEffectLine mixBlend blockColor="var(--color-main)"
        >Service</TextEffectLine
      >
    </h1>
    <h1
      class="text-4xl md:text-5xl font-bold uppercase text-main leading-[75%]"
    >
      <TextEffectLine mixBlend blockColor="var(--color-main)"
        >List</TextEffectLine
      >
    </h1>
  </div>
  <div class="flex gap-4">
    <div class="flex flex-col gap-4">
      <div
        class="w-50 h-30 border border-[#242424] text-2xl leading-[90%] text-center p-4"
      >
        Static Landing Page
      </div>
      <div
        class="w-50 h-30 border border-[#242424] text-2xl leading-[90%] text-center p-4 items-center"
      >
        Website with CMS
      </div>
      <div
        class="w-50 h-30 border border-[#242424] text-xl leading-[90%] text-center p-4"
      >
        Custom Solution
      </div>
    </div>
    <div>
      <h3>Static Landing Page</h3>
    </div>
  </div>
</section>
