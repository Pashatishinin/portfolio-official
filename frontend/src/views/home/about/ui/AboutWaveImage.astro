---
interface Props {
  imageUrl: string | null;
}

const { imageUrl } = Astro.props;
---

<div class="flex justify-center items-center w-full h-full">
  <div
    id="about-img-wrap"
    class="w-56 sm:w-64 md:w-72 lg:w-80 opacity-50 pointer-events-auto"
    style="overflow:visible"
    data-image-url={imageUrl}
  >
    <canvas id="about-canvas" style="display:block"></canvas>
  </div>
</div>

<script>
  import * as THREE from "three";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const vertexShader = `
    uniform float uTime;
    uniform float uAmplitude;
    varying vec2 vUv;
    varying float vWave;

    void main() {
      vUv = uv;
      vec3 pos = position;

      float wave  = sin(pos.y * 5.0  + uTime) * uAmplitude;
            wave += sin(pos.y * 9.0  + uTime * 1.5) * uAmplitude * 0.4;
            wave += sin(pos.y * 14.0 + uTime * 2.2) * uAmplitude * 0.15;

      pos.z = wave;
      vWave = wave;

      gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
    }
  `;

  const fragmentShader = `
    uniform sampler2D uTexture;
    varying vec2 vUv;
    varying float vWave;

    void main() {
      vec4 tex    = texture2D(uTexture, vUv);
      float light = 1.0 + vWave * 2.0;
      gl_FragColor = vec4(tex.rgb * clamp(light, 0.65, 1.35), tex.a);
    }
  `;

  function initAboutWave() {
    const canvas = document.getElementById("about-canvas") as HTMLCanvasElement;
    if (!canvas || canvas.dataset.init) return;
    canvas.dataset.init = "true";

    const wrap = canvas.parentElement!;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, -0.2, 2.2);
    camera.lookAt(0, 0, 0);

    const uniforms = {
      uTexture: { value: null as THREE.Texture | null },
      uTime: { value: 0 },
      uAmplitude: { value: 0 },
    };

    const geometry = new THREE.PlaneGeometry(2, 2, 80, 80);
    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      side: THREE.DoubleSide,
    });
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let texAspect = 1;

    function resize() {
      const w = wrap.offsetWidth;
      const pad = Math.round(w * 0.12);
      const size = w + pad * 2;
      renderer.setSize(size, size);
      canvas.style.width = `${size}px`;
      canvas.style.marginLeft = `-${pad}px`;
      canvas.style.marginTop = `-${pad}px`;
      camera.aspect = 1;
      camera.updateProjectionMatrix();
      const inner = w / size;
      mesh.scale.set(texAspect * inner, inner, 1);
    }

    const imageUrl = wrap.dataset.imageUrl;
    if (imageUrl) {
      const loader = new THREE.TextureLoader();
      loader.setCrossOrigin("anonymous");
      loader.load(imageUrl, (tex) => {
        uniforms.uTexture.value = tex;
        texAspect = tex.image.width / tex.image.height;
        resize();
      });
    }

    resize();

    const proxy = { amp: 0 };

    // 1. Анимация волн от скролла
    ScrollTrigger.create({
      trigger: "#about",
      start: "top bottom",
      end: "bottom top",
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const p = self.progress;
        const amp =
          p < 0.35
            ? (p / 0.35) * 0.05
            : p > 0.65
              ? ((1 - p) / 0.35) * 0.05
              : 0.05;
        proxy.amp = amp;
        uniforms.uTime.value = p * 30;
      },
    });

    // 2. Поворот Mesh 3D-модели
    gsap.fromTo(
      mesh.rotation,
      { z: -0.1 },
      {
        z: 0.1,
        ease: "none",
        scrollTrigger: {
          trigger: "#about",
          start: "top bottom",
          end: "bottom top",
          scrub: 1.5,
          invalidateOnRefresh: true,
        },
      },
    );

    // 3. Движение обертки картинки СНИЗУ ВВЕРХ при скролле секции #about
    gsap.fromTo(
      wrap,
      { y: "120vh" }, // Старт: вылетает снизу из-за экрана
      {
        y: "-120vh", // Конец: улетает вверх за экран
        ease: "none",
        scrollTrigger: {
          trigger: "#about",
          start: "top bottom",
          end: "bottom top",
          scrub: 1,
          invalidateOnRefresh: true,
        },
      },
    );

    let raf: number;
    function animate() {
      raf = requestAnimationFrame(animate);
      uniforms.uAmplitude.value = proxy.amp;
      renderer.render(scene, camera);
    }
    animate();

    const ro = new ResizeObserver(resize);
    ro.observe(wrap);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        renderer.dispose();
        geometry.dispose();
        material.dispose();
      },
      { once: true },
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutWave);
  } else {
    initAboutWave();
  }
  document.addEventListener("astro:after-swap", initAboutWave);
</script>
