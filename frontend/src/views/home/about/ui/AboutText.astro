---
import { TextEffectLine } from "../../../../components";

interface Props {
  bioText: string;
  extraText1?: string | null;
  extraText2?: string | null;
  extraText3?: string | null;
}

const { bioText, extraText1, extraText2, extraText3 } = Astro.props;
const extraTexts = [extraText1, extraText2, extraText3].filter(
  (text): text is string => Boolean(text),
);
---

<div
  class="min-h-svh flex flex-col items-center justify-center gap-2 sticky top-0 mix-blend-difference"
>
  <div class="flex items-center opacity-10">
    <h1
      class="font-accent italic text-[90px] sm:text-[160px] md:text-[220px] lg:text-[300px] leading-[75%] -tracking-widest text-[#1d1d1d]!"
      aria-label="About"
    >
      About
    </h1>
  </div>
  <div class="w-[90vw] sm:w-auto sm:max-w-[80vw] lg:max-w-200">
    <span class="text-lg sm:text-xl md:text-2xl lg:text-3xl">
      <TextEffectLine align="center" blockColor="#1d1d1d">
        {bioText}
      </TextEffectLine>
    </span>
  </div>

  {
    extraTexts.map((text) => (
      <div class="w-[90vw] sm:w-auto sm:max-w-[80vw] lg:max-w-200 mt-4">
        <span class="text-lg sm:text-xl md:text-2xl lg:text-3xl">
          <TextEffectLine align="center" blockColor="#1d1d1d">
            {text}
          </TextEffectLine>
        </span>
      </div>
    ))
  }
</div>
