---
import { TextEffectLine } from "../../../../components";
---

<div
  class="min-h-screen flex flex-col items-center justify-center gap-2 sticky top-0 mix-blend-difference"
>
  <div class="flex items-center opacity-10">
    <h1
      class="font-accent italic text-[90px] sm:text-[160px] md:text-[220px] lg:text-[300px] leading-[75%] -tracking-widest text-white!"
    >
      About
    </h1>
  </div>
  <div class="w-[90vw] sm:w-auto sm:max-w-[80vw] lg:max-w-200">
    <span class="text-lg sm:text-xl md:text-2xl lg:text-3xl">
      <TextEffectLine mixBlend align="center" blockColor="#141314">
        As a creative web designer, I don't just sketch layouts but build real
        products—like my own WebApp and a collection of fresh design
        cases—turning complex ideas into sleek, standout interfaces where every
        single pixel delivers results.
      </TextEffectLine>
    </span>
  </div>
</div>
