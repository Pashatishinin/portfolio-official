---
import { getAboutContent } from "../../../shared/api/home.api";
import AboutText from "./ui/AboutText.astro";
import AboutWaveImage from "./ui/AboutWaveImage.astro";

const { bioText, extraText1, extraText2, extraText3, imageUrl } =
  await getAboutContent();
---

<section
  id="about"
  class="relative h-[250vh] w-full max-w-[1920px] mx-auto z-10 isolate"
>
  <div
    class="sticky top-0 h-svh w-full overflow-hidden flex items-center justify-center p-4 sm:p-8 lg:p-16"
  >
    <!-- 1. Слой Canvas (картинка) -->
    <div
      class="absolute inset-0 z-0 pointer-events-none flex items-center justify-center"
    >
      <AboutWaveImage imageUrl={imageUrl} />
    </div>

    <!-- 2. Слой текста -->
    <div class="relative z-10 w-full mix-blend-difference pointer-events-none">
      <AboutText
        bioText={bioText}
        extraText1={extraText1}
        extraText2={extraText2}
        extraText3={extraText3}
      />
    </div>
  </div>
</section>
