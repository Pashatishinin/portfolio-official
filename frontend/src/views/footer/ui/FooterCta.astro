---
import { TextEffect, TextEffectLine } from "../../../components";
import { getFooterContact } from "../../../shared/api/home.api";

const { email, footerCta } = await getFooterContact();
---

<div class="footer-cta">
  <p class="mb-4">
    <TextEffectLine blockColor="var(--color-secondary)" mixBlend>
      {footerCta}
    </TextEffectLine>
  </p>

  <a
    href={`mailto:${email}`}
    class="link group inline-flex cursor-pointer outline-none mix-blend-difference"
    aria-label="Send an email to Pavlo Tishynin"
  >
    <div class="flex flex-wrap">
      {/* Не заголовки, а подпись ссылки: имя ссылке даёт её
          собственный aria-label выше, поэтому строки скрыты от AT. */}
      <span
        class="block font-accent text-[clamp(60px,10vw,100px)] text-white -tracking-widest leading-[75%] group-hover:-translate-y-2 transition-transform duration-500"
        aria-hidden="true"
      >
        <TextEffect>Say</TextEffect>
      </span>
      <span
        class="block text-[clamp(60px,10vw,100px)] text-white -tracking-widest leading-[75%] group-hover:-translate-y-2 transition-transform duration-500 delay-75 ml-4"
        aria-hidden="true"
      >
        <TextEffect>Hello</TextEffect>
      </span>
    </div>
  </a>
</div>

<style>
  .link {
    position: relative;
    padding-bottom: 8px;
  }

  .link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: white;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .link:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }
</style>
