---
import { LinkButton } from "../../../components";
import { getFooterContact } from "../../../shared/api/home.api";

const { socialLinks } = await getFooterContact();
---

<ul class="text-xl flex flex-col gap-2 sm:px-4">
  {
    socialLinks.map((link) => (
      <li class="social-item">
        <LinkButton
          text={link.label}
          href={link.url}
          aria={`Visit Pavlo Tishynin's ${link.label} profile`}
          class="h-0 leading-[70%] flex flex-col justify-center items-center"
        />
      </li>
    ))
  }
</ul>

<style>
  .social-item :global(.block-line) {
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .social-item:hover :global(.block-line) {
    opacity: 1;
  }
</style>
