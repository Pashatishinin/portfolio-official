---
import { LinkButton } from "../../../components";
import { getFooterContact } from "../../../shared/api/home.api";

const { email, socialLinks } = await getFooterContact();
const year = new Date().getFullYear();
---

<div class="footer-columns mt-12 sm:mt-20 mix-blend-difference">
  {/*
    На мобильном колонки складываются в одну: при grid-cols-2 на 360px
    каждая получает ~148px, а адрес почты в 16px занимает около 145 —
    он либо переносился, либо вылезал за край.
  */}
  <div class="cols grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-10">
    <div class="col">
      <h4 class="mono">Contact</h4>
      <ul>
        <li>
          <LinkButton
            text={email}
            href={`mailto:${email}`}
            aria="Send an email"
            class="email"
          />
        </li>
      </ul>
    </div>

    <div class="col">
      <h4 class="mono">Elsewhere</h4>
      <ul>
        {
          socialLinks.map((link) => (
            <li>
              <LinkButton
                text={link.label}
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria={`Visit Pavlo Tishynin's ${link.label} profile`}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col hidden sm:block">
      <h4 class="mono">Colophon</h4>
      <p>Astro, GSAP, Sanity. Built and coded by me.</p>
      <p>Typography — Unytour and Didonique.</p>
    </div>
  </div>

  <div class="rule"></div>

  <div class="legal mono">
    <span>© {year} — Pavlo Tishynin</span>
    <button
      type="button"
      class="to-top logo-container inline-block cursor-pointer"
      aria-label="Scroll back to top"
    >
      <div class="overflow-hidden h-[20px] relative">
        <div class="logo-wrapper">
          <p class="logo-text m-0">Back to top ↑</p>
          <p class="logo-text m-0 absolute top-0 left-0 w-full opacity-0">
            Back to top ↑
          </p>
        </div>
      </div>
    </button>
  </div>
</div>

<script>
  // Родной переход по "#" со SmoothScroll не работает: Lenis перехватывает
  // прокрутку, и страница остаётся на месте. Поэтому кнопка, а не ссылка,
  // и скролл через сам инстанс — он выставлен в window.lenis
  // в SmoothScroll.astro. Фолбэк на случай, если Lenis отключён
  // (например, при prefers-reduced-motion).
  const bindToTop = () => {
    document.querySelectorAll<HTMLButtonElement>(".to-top").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", () => {
        const lenis = (window as any).lenis;
        if (lenis?.scrollTo) {
          lenis.scrollTo(0, { duration: 1.2 });
        } else {
          const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        }
      });
    });
  };

  bindToTop();
  document.addEventListener("astro:page-load", bindToTop);
</script>

<style is:global>
  /* Email/social links now render through LinkButton (separate file) for
     its char-swap hover animation, and the "Back to top" button
     replicates LinkButton's own DOM structure so the same globally
     already-loaded script (queries .logo-container document-wide) picks
     it up too — scoped Astro styles can't reach elements rendered by a
     different component file, hence is:global here. */
  .mono {
    font-family: "JetBrains Mono", monospace;
    /* было 0.62rem при opacity 0.34 — под mix-blend-difference
       это уходило почти в фон; 11px и 0.45 читаются, оставаясь подписью */
    font-size: 0.69rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 246, 240, 0.45);
  }

  .col {
    min-width: 0; /* иначе длинная почта распирает колонку грида */
  }

  .col h4 {
    margin: 0 0 0.7rem;
    font-weight: 400;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .col li a {
    display: inline-block;
    font-size: 1rem;
    font-weight: 500;
    color: #faf6f0;
  }
  .col li a:focus-visible {
    outline: 1px solid #faf6f0;
    outline-offset: 4px;
  }

  /* адрес почты — самое длинное слово в футере, ему нужен перенос */
  .email {
    overflow-wrap: anywhere;
  }

  .col p {
    margin: 0;
    color: rgba(250, 246, 240, 0.58);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 34ch;
  }
  .col p + p {
    margin-top: 0.4rem;
  }

  .rule {
    height: 1px;
    background: rgba(250, 246, 240, 0.16);
    margin: 1.4rem 0 1.1rem;
  }

  .legal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
  }

  .to-top {
    /* кнопка, а не ссылка: действие на странице, а не переход по адресу */
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
  }
  .to-top:focus-visible {
    outline: 1px solid #faf6f0;
    outline-offset: 4px;
  }
</style>
