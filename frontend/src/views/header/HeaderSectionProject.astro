---
import Logo from "../../components/ui/buttons/Logo.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section
  class="header fixed inset-x-0 z-999 flex justify-between px-4 sm:px-16 py-8 max-w-480 mx-auto"
>
  <Logo />
  {title && <span class="project-title uppercase font-medium">{title}</span>}
</section>

<style>
  .header {
    mix-blend-mode: difference;
    color: white;
  }
</style>

<script>
  import gsap from "gsap";

  document.addEventListener("astro:page-load", () => {
    gsap.from(".header", { y: "-150%", duration: 1.2, ease: "expo.out" });
  });
</script>
