---
import video1 from "../../assets/blive/1.mp4";
import video2 from "../../assets/blive/2.mp4";
import video3 from "../../assets/blive/3.mp4";
import video4 from "../../assets/blive/4.mp4";
import video5 from "../../assets/blive/5.mp4";
import mainImg from "../../assets/blive/blive-main.jpg";
import Layout from "../../layouts/Layout.astro";
import FooterSection from "../../views/footer/FooterSection.astro";
import HeaderSectionProject from "../../views/header/HeaderSectionProject.astro";
import {
  AboutProjectSection,
  HeroSection,
  NextProjectSection,
  ShortPreviewSection,
} from "../../views/project";

const videos = [
  { src: video1, poster: "/blive-cover.jpg" },
  { src: video2, poster: "/blive-cover.jpg" },
  { src: video3, poster: "/blive-cover.jpg" },
  { src: video4, poster: "/blive-cover.jpg" },
  { src: video5, poster: "/blive-cover.jpg" },
];

const role = ["Design", "Frontend Development", "CMS Architecture"];
const tools = ["React.js", "Vite", "Tailwind CSS", "GSAP", "Figma"];
---

<Layout>
  <HeaderSectionProject title="Blive Coaching" />
  <HeroSection text="BLive Coaching" img={mainImg} />
  <AboutProjectSection role={role} tools={tools} year="2024" />
  <ShortPreviewSection listVideo={videos} />
  <NextProjectSection link="/vettar" />
  <FooterSection />
</Layout>
