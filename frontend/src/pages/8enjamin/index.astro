---
import video1 from "../../assets/8enjamin/1.mp4";
import video2 from "../../assets/8enjamin/2.mp4";
import video3 from "../../assets/8enjamin/3.mp4";
import video4 from "../../assets/8enjamin/4.mp4";
import video5 from "../../assets/8enjamin/5.mp4";
import mainImg from "../../assets/8enjamin/benjamin-main.jpg";
import Layout from "../../layouts/Layout.astro";
import FooterSection from "../../views/footer/FooterSection.astro";
import HeaderSectionProject from "../../views/header/HeaderSectionProject.astro";
import {
  AboutProjectSection,
  HeroSection,
  NextProjectSection,
  ShortPreviewSection,
} from "../../views/project";

const videos = [
  { src: video1, poster: "/benjamin-cover.jpg" },
  { src: video2, poster: "/benjamin-cover.jpg" },
  { src: video3, poster: "/benjamin-cover.jpg" },
  { src: video4, poster: "/benjamin-cover.jpg" },
  { src: video5, poster: "/benjamin-cover.jpg" },
];

const role = ["Design", "Frontend Development", "CMS Architecture"];
const tools = ["Next.js", "Tailwind CSS", "GSAP", "Figma", "CMS Sanity"];
const info =
  " This project is a showcase of one clothing designer, where the style and work of the designer are conveyed as much as possible.";
---

<Layout>
  <HeaderSectionProject title="8enjamin" />
  <HeroSection text="8enjamin" img={mainImg} />
  <AboutProjectSection role={role} tools={tools} year="2025" info={info} />

  <ShortPreviewSection listVideo={videos} />
  <NextProjectSection link="/ahin-anburaja" />
  <FooterSection />
</Layout>
