---
import { Object3D } from "../components";
import CrystalController from "../components/animation/CrystalController.astro";
import Layout from "../layouts/Layout.astro";
import FooterSection from "../views/footer/FooterSection.astro";
import HeaderSection from "../views/header/HeaderSection.astro";
import {
  AchievementSection,
  HeroSection,
  MilestonesSection,
  MyWorks,
  PreviewSection,
  SelectedWorksSection,
} from "../views/home";
import AboutSection from "../views/home/about/AboutSection.astro";
---

<Layout>
  <Object3D transition:persist />
  <CrystalController />
  <HeaderSection />

  <main id="main">
    <HeroSection />
    <!-- <PreviewSection /> -->

    <SelectedWorksSection />
    <MilestonesSection />
    <AboutSection />
    <AchievementSection />
  </main>

  <FooterSection />
</Layout>
