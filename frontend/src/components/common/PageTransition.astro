<div
  class="page-transition-layer fixed inset-0 top-0 bg-[#1d1d1d] z-10000 h-[200vh] w-screen translate-y-full pointer-events-none"
  style="will-change: transform;"
>
</div>

<script>
  import gsap from "gsap";

  const initPageTransitions = () => {
    const layer = document.querySelector<HTMLElement>(".page-transition-layer");
    if (!layer) return;

    gsap.set(layer, { yPercent: 120, skewY: 0 });

    document.addEventListener(
      "astro:before-preparation",
      (ev) => {
        const isNavigatingToHome = ev.to.pathname === "/";
        if (!isNavigatingToHome) return;

        const originalLoader = ev.loader;

        ev.loader = async () => {
          await gsap.to(layer, {
            yPercent: -130,
            skewY: -5,
            duration: 1.5,
            ease: "power4.out",
          });

          await originalLoader();
        };
      },
      { once: true },
    );

    document.addEventListener("astro:after-swap", () => {
      gsap.set(layer, { yPercent: 120 });
    });
  };

  document.addEventListener("astro:page-load", initPageTransitions);
</script>
