<three-crystal>
  <div class="three-container"></div>
</three-crystal>
<style>
  three-crystal {
    display: block !important;
    width: 800px !important;
    height: 800px !important;
    position: fixed !important;
    z-index: 99999 !important;
    pointer-events: none !important;
    transform-origin: center center;
    opacity: 30% !important;
  }
  .three-container {
    width: 100% !important;
    height: 100% !important;
  }
</style>
<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

  /**
   * Внешний "вход" для управления объектом. Любой скрипт на странице
   * (скролл-контроллеры, конкретные секции) может достать инстанс из
   * window.crystalInstances / события "crystal:ready" и менять эти поля
   * (напрямую или через gsap.to(crystal.target, {...})) — сам компонент
   * в каждом кадре складывает их с базовой холостой анимацией в movement().
   * Так у объекта всегда один источник правды на кадр, и разные секции
   * не дёргают model.rotation/position напрямую и не конфликтуют друг с другом.
   */
  interface CrystalTarget {
    rotationY: number; // доп. поворот по Y поверх холостого спина, радианы
    rotationX: number; // доп. поворот по X, радианы
    rotationZ: number; // доп. поворот по Z, радианы
    positionY: number; // доп. смещение по Y поверх покачивания
    scale: number; // множитель масштаба (1 = как в GLTF)
  }

  class ThreeCrystal extends HTMLElement {
    private renderer: THREE.WebGLRenderer | null = null;
    private rafId: number | null = null;
    model: THREE.Group | null = null;
    private mixer: THREE.AnimationMixer | null = null; // Миксер для встроенных анимаций
    private clock = new THREE.Clock();
    // connectedCallback может вызваться повторно для одного и того же
    // элемента. this.model/this.target/this.clock — свойства инстанса,
    // общие для всех вызовов; если дать connectedCallback отработать
    // больше одного раза, получится несколько независимых scene/renderer/
    // tick()-циклов, которые все дерутся за одно и то же состояние —
    // видимый canvas и реально управляемый через target могут разъехаться.
    // Поэтому вся тяжёлая инициализация должна выполниться строго один раз.
    private initialized = false;

    target: CrystalTarget = {
      rotationY: 0,
      rotationX: 0,
      rotationZ: 0,
      positionY: 0,
      scale: 1,
    };

    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;

      const container = this.querySelector(".three-container");
      if (!container) return;

      const crystals = ((window as any).crystalInstances ??= []);
      crystals.push(this);

      this.renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      this.renderer.setSize(800, 800);

      this.renderer.outputColorSpace = THREE.SRGBColorSpace;
      this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
      this.renderer.toneMappingExposure = 2.2;

      container.appendChild(this.renderer.domElement);

      const scene = new THREE.Scene();

      const pmremGenerator = new THREE.PMREMGenerator(this.renderer);
      pmremGenerator.compileEquirectangularShader();
      scene.environment = pmremGenerator.fromScene(new THREE.Scene()).texture;

      const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 5000);
      camera.position.set(0, 0, 130.5);

      scene.add(new THREE.AmbientLight(0xffffff, 2.0));

      const frontLight = new THREE.DirectionalLight(0xffffff, 4.0);
      frontLight.position.set(3, 5, 3);
      scene.add(frontLight);

      const blueBackLight = new THREE.DirectionalLight(0x00aaff, 6.0);
      blueBackLight.position.set(-5, -3, -5);
      scene.add(blueBackLight);

      const loader = new GLTFLoader();
      loader.load(
        "/object/scene.gltf",
        (gltf) => {
          this.model = gltf.scene ?? gltf.scenes[0];
          if (!this.model) return;

          // Возвращаем медузе её нормальные пропорции 1:1:1
          this.model.scale.set(1, 1, 1);
          this.model.position.set(0, -0.5, 0);

          // ИСПРАВЛЕНО: Запуск встроенной профессиональной анимации
          if (gltf.animations && gltf.animations.length > 0) {
            this.mixer = new THREE.AnimationMixer(this.model);

            // Берем первую анимацию (обычно это цикл плавания).
            // Если она покажется не той, можно поменять индекс на 1, 2 и т.д.
            const animationTrack = gltf.animations[0];
            const action = this.mixer.clipAction(animationTrack);

            action.play();
          }

          let meshIndex = 0;

          this.model.traverse((obj) => {
            if ((obj as THREE.Mesh).isMesh) {
              const mesh = obj as THREE.Mesh;
              mesh.frustumCulled = false;

              // Считаем каждый найденный меш
              meshIndex++;

              if (mesh.material) {
                const materials = Array.isArray(mesh.material)
                  ? mesh.material
                  : [mesh.material];

                materials.forEach((mat) => {
                  if ("transparent" in mat) mat.transparent = true;

                  if ("depthWrite" in mat) mat.depthWrite = false;

                  // Делаем весь материал матовым и мутным

                  if ("roughness" in mat) mat.roughness = 4; // Чем выше, тем более мутная поверхность (до 1.0)

                  // if ("metalness" in mat) mat.metalness = 0.0;

                  // Включаем эффект подповерхностного размытия/преломления

                  if ("transmission" in mat) (mat as any).transmission = 0.7;

                  if ("thickness" in mat) (mat as any).thickness = 20.0;

                  // Твоя рабочая настройка цвета и прозрачности

                  if ("color" in mat && (mat as any).color) {
                    (mat as any).color.multiplyScalar(0.4);

                    const pinkTint = new THREE.Color(0.15, 0.03, 0.08);

                    (mat as any).color.add(pinkTint);
                  }

                  if ("opacity" in mat) {
                    (mat as any).opacity = Math.min(
                      (mat as any).opacity * 1.2,

                      1.0,
                    );
                  }
                });

                //   if ("transparent" in mat) mat.transparent = true;
                //   if ("depthWrite" in mat) mat.depthWrite = false;

                //   // Обычные настройки для всей медузы
                //   if ("roughness" in mat) mat.roughness = 0.5;

                //   if ("color" in mat && (mat as any).color) {
                //     (mat as any).color.multiplyScalar(0.4);

                //     const pinkTint = new THREE.Color(0.15, 0.03, 0.08);

                //     (mat as any).color.add(pinkTint);
                //   }

                //   // ПРОВЕРКА: Пробуем поймать шапку.
                //   // Обычно в GLB самый первый (1) или самый тяжелый меш — это купол.
                //   // Если покрасятся щупальца, просто поменяй 1 на 2, 3 или 4!
                //   const isCap = meshIndex === 1;

                //   if ("color" in mat && (mat as any).color) {
                //     if (isCap) {
                //       if ("roughness" in mat) mat.roughness = 1;
                //       // КРАСИМ ШАПКУ: делаем её более яркой, насыщенной и розовой
                //       (mat as any).color.setHex(0xff00aa); // Чистый неоново-розовый цвет
                //       (mat as any).color.multiplyScalar(0.3); // Приглушаем под твою общую яркость
                //     } else {
                //       // КРАСИМ ЩУПАЛЬЦА: твой стандартный рабочий цвет
                //       (mat as any).color.multiplyScalar(0.4);
                //       const pinkTint = new THREE.Color(0.15, 0.03, 0.08);
                //       (mat as any).color.add(pinkTint);
                //     }
                //   }

                //   // Для шапки делаем прозрачность плотнее, чтобы она казалась закрашенной
                //   if ("opacity" in mat) {
                //     const baseOpacity = isCap ? 0.9 : 0.4; // Шапка почти непрозрачная, щупальца — воздушные
                //     (mat as any).opacity = baseOpacity;
                //   }
                // });
              }
            }
          });

          scene.add(this.model);
          window.dispatchEvent(
            new CustomEvent("crystal:ready", { detail: { element: this } }),
          );
        },
        undefined,
        (err) => console.error("GLB Loading Error:", err),
      );

      const tick = () => {
        this.rafId = requestAnimationFrame(tick);

        const delta = this.clock.getDelta();
        const elapsedTime = this.clock.getElapsedTime();

        if (this.mixer) {
          this.mixer.update(delta * 1.0);
        }

        this.movement(elapsedTime);

        camera.lookAt(0, 0, 0);

        if (this.renderer) {
          this.renderer.render(scene, camera);
        }
      };
      tick();
    }

    /**
     * Единственное место, где меняются position/rotation/scale модели.
     * Каждый кадр применяет this.target — данными, которые снаружи
     * выставляют скролл-контроллеры/секции (постоянного холостого спина
     * больше нет — объект вращается только когда это явно задано через
     * target). Если понадобится новый вид движения, добавляй поле в
     * CrystalTarget и считай его здесь же — это единая точка правды,
     * никакой другой код не должен трогать model.rotation/position напрямую.
     */
    private movement(elapsedTime: number) {
      if (!this.model) return;

      this.model.rotation.y = this.target.rotationY;
      this.model.rotation.x = this.target.rotationX;
      this.model.rotation.z = this.target.rotationZ;

      const bob = Math.sin(elapsedTime * 0.8) * 0.15;
      this.model.position.y = -0.5 + bob + this.target.positionY;

      this.model.scale.setScalar(this.target.scale);
    }

    disconnectedCallback() {
      if (this.rafId) cancelAnimationFrame(this.rafId);
      if (this.renderer) {
        this.renderer.dispose();
        this.renderer.domElement.remove();
      }
      const crystals = (window as any).crystalInstances as
        | ThreeCrystal[]
        | undefined;
      if (crystals) {
        const idx = crystals.indexOf(this);
        if (idx !== -1) crystals.splice(idx, 1);
      }
    }
  }

  if (!customElements.get("three-crystal")) {
    customElements.define("three-crystal", ThreeCrystal);
  }
</script>
