  </div>

  <script>
    import gsap from "gsap";
    import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

    gsap.registerPlugin(DrawSVGPlugin);

    const setup = () => {
      const preloader = document.querySelector(".preloader");
      if (!preloader) return;

      const navEntries = performance.getEntriesByType("navigation");
      const isReload =
        navEntries.length > 0 &&
        (navEntries[0] as PerformanceNavigationTiming).type === "reload";
      const isFirstLoad = !sessionStorage.getItem("alreadyVisited");

      // Второй, независимый от глобального (Layout.astro), инстанс
      // Object3D — живёт только внутри прелоадера. Разворачиваем его
      // статично на тот же угол по X, в который в итоге приходит объект
      // в PreviewSection (см. CrystalController -> preview-rotate), и
      // проигрываем короткое появление: scale 0 -> 1 через 0.5с.
      const initPreloaderCrystalRotation = () => {
        const crystal = document.querySelector<any>(".preloader three-crystal");
        if (!crystal) return;

        const setupCrystal = () => {
          crystal.target.rotationX = -Math.PI / 2;
          crystal.target.scale = 0;
          gsap.to(crystal.target, {
            scale: 1,
            delay: 0.9,
            duration: 0.5,
            ease: "back.out(1.7)",
          });
        };

        if (crystal.model) {
          setupCrystal();
        } else {
          window.addEventListener(
            "crystal:ready",
            (e: Event) => {
              if ((e as CustomEvent).detail.element === crystal) setupCrystal();
            },
            { once: true },
          );
        }
      };

      const initGapAnimation = () => {
        const isMobile = window.innerWidth < 1024;
        const gapDelay = 1.2;
        const gapDuration = 1.5;

        const timeline = gsap.timeline({ delay: gapDelay });

        timeline.from(".grid-container", {
          gap: isMobile ? "5px" : "20px",
          duration: gapDuration,
          ease: "expo.out",
        });

        return timeline;
      };

      const initProgressTimer = () => {
        const svg = document.querySelector(".preloader-svg");
        const strokes = document.querySelectorAll(".preloader-stroke");
        if (!svg || strokes.length === 0) return;

        gsap.set(svg, { autoAlpha: 0 });
        gsap.set(strokes, { drawSVG: "0%", autoAlpha: 1 });

        gsap.to(svg, {
          autoAlpha: 1,
          duration: 0.2,
          delay: 1,
          ease: "power2.out",
        });

        gsap.to(strokes, {
          drawSVG: "100%",
          autoAlpha: 1,
          duration: 2,
          delay: 1,
          stagger: 0.15,
          ease: "power2.inOut",
        });
      };

      // Ждём реальную готовность контента (шрифты + все ресурсы страницы,
      // включая тяжёлые чанки FluidScene/Object3D), а не полагаемся на то,
      // что фиксированная задержка всегда успеет — на холодном первом
      // визите загрузка может занять дольше 3.2с, и прелоадер уезжал раньше,
      // чем текст/фон/анимации успевали отрисоваться.
      const fontsReady =
        (document.fonts && document.fonts.ready) || Promise.resolve();
      const windowReady =
        document.readyState === "complete"
          ? Promise.resolve()
          : new Promise<void>((resolve) =>
              window.addEventListener("load", () => resolve(), { once: true }),
            );

      // Сохраняем исходный тайминг (svg/текст успевают доиграть к ~3.2с),
      // но не уезжаем раньше, чем контент реально готов.
      const minPacing = new Promise<void>((resolve) =>
        setTimeout(resolve, 3200),
      );
      // Страховка: не блокируем показ сайта дольше 6с, даже если что-то
      // (например, шрифт) так и не подтвердит готовность.
      const safetyTimeout = new Promise<void>((resolve) =>
        setTimeout(resolve, 6000),
      );

      const contentReady = Promise.race([
        Promise.all([fontsReady, windowReady]),
        safetyTimeout,
      ]);
      const readyToExit = Promise.all([contentReady, minPacing]);

      const initBgPreloader = () => {
        readyToExit.then(() => {
          gsap.to(".preloader", {
            yPercent: -150,
            skewY: -15,
            duration: 1.5,
            ease: "expo.inOut",
            onStart: () => {
              sessionStorage.setItem("alreadyVisited", "true");
            },
            onComplete: () => {
              gsap.set(".preloader", { skewY: 0 });
            },
          });
        });
      };

      function initPreloaderImages() {
        const wrappers = document.querySelectorAll(".img-wrapper");
        if (wrappers.length === 0) return;

        gsap.set(wrappers, { height: "0%", yPercent: 0, scale: 1, skewY: 20 });

        const tl = gsap.timeline({
          delay: 2.0,
        });

        wrappers.forEach((wrapper, index) => {
          tl.to(wrapper, {
            height: "100%",
            skewY: 0,
            duration: 0.1 + index * 0.05,
            ease: "expo.out",
          });
        });
      }

      initPreloaderCrystalRotation();

      if (isFirstLoad || isReload) {
        const gapAnimation = initGapAnimation();
        // gapAnimation.eventCallback("onComplete", initProgressTimer);
        initProgressTimer();
        initBgPreloader();
        initPreloaderImages();
      } else {
        gsap.set(preloader, { display: "none" });
      }

      document.addEventListener("astro:page-load", initPreloaderImages);
    };

    setup();
  </script>
</section>
