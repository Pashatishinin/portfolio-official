---
import { Object3D } from "..";
import TextEffect from "../animation/TextEffect.astro";
---

<section
  class="fixed inset-0 preloader z-200000 bg-[#131313] flex flex-col justify-center items-center"
  aria-hidden="true"
>
  <Object3D />

  <div
    class="grid-container relative grid grid-cols-1 lg:grid-cols-2 gap-[100px] sm:gap-[400px] px-6"
  >
    <div class="block text-center lg:text-right">
      <div
        class="font-accent font-bold -tracking-widest text-secondary text-[clamp(36px,8vw,64px)] leading-[75%]"
      >
        <TextEffect delay={0.3}>Pavlo</TextEffect>
      </div>
      <div
        class="font-black -tracking-[0.06em] text-secondary text-[clamp(36px,8vw,64px)] leading-[75%]"
      >
        <TextEffect delay={0.35}>Tishynin</TextEffect>
      </div>
    </div>

    <div class="block text-center lg:text-left">
      <div
        class="font-accent font-bold -tracking-widest text-secondary text-[clamp(36px,8vw,64px)] leading-[75%]"
      >
        <TextEffect delay={0.3}>Creative</TextEffect>
      </div>
      <div
        class="font-black -tracking-[0.06em] text-secondary text-[clamp(36px,8vw,64px)] leading-[75%]"
      >
        <TextEffect delay={0.35}>Technologist</TextEffect>
      </div>
    </div>
  </div>

  <script>
    import gsap from "gsap";
    import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

    gsap.registerPlugin(DrawSVGPlugin);

    const setup = () => {
      const preloader = document.querySelector(".preloader");
      if (!preloader) return;

      const navEntries = performance.getEntriesByType("navigation");
      const isReload =
        navEntries.length > 0 &&
        (navEntries[0] as PerformanceNavigationTiming).type === "reload";
      const isFirstLoad = !sessionStorage.getItem("alreadyVisited");

      // Второй, независимый от глобального (Layout.astro), инстанс
      // Object3D — живёт только внутри прелоадера. Разворачиваем его
      // статично на тот же угол по X, в который в итоге приходит объект
      // в PreviewSection (см. CrystalController -> preview-rotate), и
      // проигрываем короткое появление: scale 0 -> 1 через 0.5с.
      const initPreloaderCrystalRotation = () => {
        const crystal = document.querySelector<any>(".preloader three-crystal");
        if (!crystal) return;

        // const setupCrystal = () => {
        //   if (!crystal.target) return;

        //   // 1. Используем gsap.set вместо принудительного присвоения = 0
        //   gsap.set(crystal.target, {
        //     rotationX: -Math.PI / 2,
        //     scale: 0,
        //   });

        //   // 2. Запускаем анимацию проявления
        //   gsap.to(crystal.target, {
        //     scale: 1,
        //     delay: 0.9,
        //     duration: 0.6,
        //     ease: "back.out(1.7)",
        //     overwrite: "auto", // Очищает конфликтные твины, если они были
        //   });
        // };

        // if (crystal.model) {
        //   setupCrystal();
        // } else {
        //   window.addEventListener(
        //     "crystal:ready",
        //     (e: Event) => {
        //       if ((e as CustomEvent).detail.element === crystal) {
        //         setupCrystal();
        //       }
        //     },
        //     { once: true },
        //   );
        // }
        const startAnimation = () => {
          // 1. Убеждаемся, что поворот зафиксирован
          if (crystal.target) {
            crystal.target.rotationX = -Math.PI / 2;
            crystal.target.scale = 1; // Оставляем базовый масштаб Three.js равным 1
          }

          // 2. Анимируем появление самого WebGL-контейнера через GSAP
          gsap.fromTo(
            crystal,
            {
              scale: 0,
              opacity: 0,
            },
            {
              scale: 1,
              opacity: 0.5,
              delay: 0.4,
              duration: 0.5,
              ease: "back.out(1.7)",
              onStart: () => {
                crystal.classList.remove("opacity-0");
              },
            },
          );
        };

        // Проверка готовности модели и трехмерной сцены
        if (crystal.model && crystal.target) {
          // Маленький таймаут гарантирует, что Three.js завершил первый кадр рендера
          setTimeout(startAnimation, 50);
        } else {
          window.addEventListener(
            "crystal:ready",
            () => {
              setTimeout(startAnimation, 50);
            },
            { once: true },
          );
        }
      };

      const initGapAnimation = () => {
        const isMobile = window.innerWidth < 1024;
        const gapDelay = 0.6;
        const gapDuration = 0.9;

        const timeline = gsap.timeline({ delay: gapDelay });

        timeline.from(".grid-container", {
          gap: isMobile ? "5px" : "20px",
          duration: gapDuration,
          ease: "expo.out",
        });

        return timeline;
      };

      const initProgressTimer = () => {
        const svg = document.querySelector(".preloader-svg");
        const strokes = document.querySelectorAll(".preloader-stroke");
        if (!svg || strokes.length === 0) return;

        gsap.set(svg, { autoAlpha: 0 });
        gsap.set(strokes, { drawSVG: "0%", autoAlpha: 1 });

        gsap.to(svg, {
          autoAlpha: 1,
          duration: 0.2,
          delay: 0.5,
          ease: "power2.out",
        });

        gsap.to(strokes, {
          drawSVG: "100%",
          autoAlpha: 1,
          duration: 1.1,
          delay: 0.5,
          stagger: 0.08,
          ease: "power2.inOut",
        });
      };

      // Ждём реальную готовность контента (шрифты + все ресурсы страницы,
      // включая тяжёлые чанки FluidScene/Object3D), а не полагаемся на то,
      // что фиксированная задержка всегда успеет — на холодном первом
      // визите загрузка может занять дольше 3.2с, и прелоадер уезжал раньше,
      // чем текст/фон/анимации успевали отрисоваться.
      const fontsReady =
        (document.fonts && document.fonts.ready) || Promise.resolve();
      // Раньше здесь ждали window.load. Проблема в том, что load
      // наступает только после ВСЕХ ресурсов, включая медузу на 7,8 МБ:
      // в PageSpeed она едет 5,4 с, и прелоадер висел до страховочных
      // 6 с вместо своих 3,2. Модели не обязательно быть готовой к
      // моменту показа сайта — она догрузится и появится сама.
      // Ждём разметку и шрифты: этого достаточно, чтобы текст не прыгнул.
      const domReady =
        document.readyState !== "loading"
          ? Promise.resolve()
          : new Promise<void>((resolve) =>
              document.addEventListener("DOMContentLoaded", () => resolve(), {
                once: true,
              }),
            );

      // Было 3200 — под финиш обводки SVG, которая рисовалась с 1-й по
      // 3-ю секунду. Вся хореография ниже сжата вдвое, поэтому обводка
      // теперь заканчивается к ~1.6с, и порог сдвинут следом.
      // Этот таймер держал LCP: текст Hero невидим, пока идёт прелоадер.
      const minPacing = new Promise<void>((resolve) =>
        setTimeout(resolve, 1700),
      );
      // Страховка: не блокируем показ сайта дольше 6с, даже если что-то
      // (например, шрифт) так и не подтвердит готовность.
      const safetyTimeout = new Promise<void>((resolve) =>
        setTimeout(resolve, 6000),
      );

      const contentReady = Promise.race([
        Promise.all([fontsReady, domReady]),
        safetyTimeout,
      ]);
      const readyToExit = Promise.all([contentReady, minPacing]);

      const initBgPreloader = () => {
        readyToExit.then(() => {
          gsap.to(".preloader", {
            yPercent: -150,
            skewY: -15,
            duration: 1.5,
            ease: "expo.inOut",
            onStart: () => {
              sessionStorage.setItem("alreadyVisited", "true");
            },
            onComplete: () => {
              gsap.set(".preloader", { skewY: 0 });
            },
          });
        });
      };

      function initPreloaderImages() {
        const wrappers = document.querySelectorAll(".img-wrapper");
        if (wrappers.length === 0) return;

        gsap.set(wrappers, { height: "0%", yPercent: 0, scale: 1, skewY: 20 });

        const tl = gsap.timeline({
          delay: 1.0,
        });

        wrappers.forEach((wrapper, index) => {
          tl.to(wrapper, {
            height: "100%",
            skewY: 0,
            duration: 0.1 + index * 0.05,
            ease: "expo.out",
          });
        });
      }

      initPreloaderCrystalRotation();

      if (isFirstLoad || isReload) {
        const gapAnimation = initGapAnimation();
        // gapAnimation.eventCallback("onComplete", initProgressTimer);
        initProgressTimer();
        initBgPreloader();
        initPreloaderImages();
      } else {
        gsap.set(preloader, { display: "none" });
      }

      document.addEventListener("astro:page-load", initPreloaderImages);
    };

    setup();
  </script>
</section>
