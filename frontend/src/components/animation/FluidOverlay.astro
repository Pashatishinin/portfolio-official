---
interface Props {
  image?: string;
}
---

<canvas class="fluid-overlay-canvas" data-image={Astro.props.image ?? "/1.avif"}
></canvas>

<script>
  import * as THREE from "three";

  const SIM = 512;

  const vertexShader = `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  const simulationFragmentShader = `
    uniform sampler2D textureA;
    uniform vec2  mouse;
    uniform vec2  resolution;
    uniform float time;
    uniform float frame;
    varying vec2  vUv;

    const float delta = 1.4;

    void main() {
      vec2 uv = vUv;
      if (frame < 0.5) {
        gl_FragColor = vec4(0.0);
        return;
      }

      vec4  data     = texture2D(textureA, uv);
      float pressure = data.x;
      float pVel     = data.y;

      vec2  texel   = 1.0 / resolution;
      float p_right = texture2D(textureA, uv + vec2( texel.x, 0.0)).x;
      float p_left  = texture2D(textureA, uv + vec2(-texel.x, 0.0)).x;
      float p_up    = texture2D(textureA, uv + vec2(0.0,  texel.y)).x;
      float p_down  = texture2D(textureA, uv + vec2(0.0, -texel.y)).x;

      if (uv.x <= texel.x)        p_left  = p_right;
      if (uv.x >= 1.0 - texel.x) p_right = p_left;
      if (uv.y <= texel.y)        p_down  = p_up;
      if (uv.y >= 1.0 - texel.y) p_up    = p_down;

      pVel     += delta * (-2.0 * pressure + p_right + p_left) / 4.0;
      pVel     += delta * (-2.0 * pressure + p_up    + p_down) / 4.0;
      pressure += delta * pVel;
      pVel     -= 0.005 * delta * pressure;
      pVel     *= 1.0 - 0.010 * delta;
      pressure *= 0.988;

      vec2 mouseUV = mouse / resolution;
      if (mouse.x > 0.0) {
        float dist = distance(uv, mouseUV);
        if (dist <= 0.07) {
          pressure += 0.35 * (1.0 - dist / 0.07);
        }
      }

      gl_FragColor = vec4(pressure, pVel, (p_right - p_left) / 2.0, (p_up - p_down) / 2.0);
    }
  `;

  const renderFragmentShader = `
    uniform sampler2D textureA;
    uniform sampler2D textureB;
    varying vec2 vUv;

    const float SCALE = 0.95;

    void main() {
      vec4 data       = texture2D(textureA, vUv);
      vec2 distortion = 0.3 * data.zw;

      // shrink image so ~9% margin on each side stays transparent — edges visibly animate
      vec2 imgUV = (vUv - 0.5) / SCALE + 0.5 + distortion;

      vec2  inB  = step(0.0, imgUV) * step(imgUV, vec2(1.0));
      float mask = inB.x * inB.y;

      vec4 color = texture2D(textureB, clamp(imgUV, 0.0, 1.0)) * mask;

      vec3 normal   = normalize(vec3(-data.z * 2.0, 0.5, -data.w * 2.0));
      vec3 lightDir = normalize(vec3(-3.0, 10.0, 3.0));
      float specular = pow(max(0.0, dot(normal, lightDir)), 60.0) * 1.5;

      gl_FragColor = vec4(color.rgb + specular * mask, mask);
    }
  `;

  /**
   * Эффект живёт только под курсором: на тач-устройстве он физически
   * не может сработать, а стоит дорого — отдельный WebGLRenderer и два
   * WebGLRenderTarget 512×512 на КАЖДЫЙ проект в списке.
   * Обложка при этом никуда не девается: она лежит в разметке
   * отдельным <img>, канвас просто накрывает её сверху.
   */
  const CAN_HOVER_FX =
    window.matchMedia("(min-width: 1024px) and (hover: hover)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initFluidOverlays() {
    if (!CAN_HOVER_FX) return;

    document
      .querySelectorAll<HTMLCanvasElement>(
        ".fluid-overlay-canvas:not([data-fluid-init])",
      )
      .forEach((canvas) => {
        canvas.dataset.fluidInit = "true";
        const parent = canvas.parentElement!;
        const imageUrl = canvas.dataset.image || "/1.avif";

        let pw = Math.max(parent.offsetWidth, 1);
        let ph = Math.max(parent.offsetHeight, 1);
        canvas.width = pw;
        canvas.height = ph;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true });
        renderer.setClearColor(0, 0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(pw, ph);

        const rtOpts: THREE.RenderTargetOptions = {
          minFilter: THREE.LinearFilter,
          magFilter: THREE.LinearFilter,
          format: THREE.RGBAFormat,
          type: THREE.HalfFloatType,
          depthBuffer: false,
          stencilBuffer: false,
        };
        let rtA = new THREE.WebGLRenderTarget(SIM, SIM, rtOpts);
        let rtB = new THREE.WebGLRenderTarget(SIM, SIM, rtOpts);

        // ── simulation ────────────────────────────────────────────────
        const simScene = new THREE.Scene();
        const simCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
        const mouse = new THREE.Vector2(0, 0);

        const simMat = new THREE.ShaderMaterial({
          uniforms: {
            textureA: { value: null },
            mouse: { value: mouse },
            resolution: { value: new THREE.Vector2(SIM, SIM) },
            time: { value: 0 },
            frame: { value: 0 },
          },
          vertexShader,
          fragmentShader: simulationFragmentShader,
        });
        simScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), simMat));

        // ── render ────────────────────────────────────────────────────
        const renderScene = new THREE.Scene();
        const renderCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

        const imageTexture = new THREE.TextureLoader().load(imageUrl);
        imageTexture.minFilter = THREE.LinearFilter;
        imageTexture.magFilter = THREE.LinearFilter;

        const renderMat = new THREE.ShaderMaterial({
          uniforms: {
            textureA: { value: null },
            textureB: { value: imageTexture },
          },
          vertexShader,
          fragmentShader: renderFragmentShader,
          transparent: true,
        });
        renderScene.add(
          new THREE.Mesh(new THREE.PlaneGeometry(2, 2), renderMat),
        );

        // ── animate ───────────────────────────────────────────────────
        let frameCount = 0;

        function animate() {
          requestAnimationFrame(animate);

          frameCount++;
          simMat.uniforms.frame.value = frameCount;
          simMat.uniforms.time.value = performance.now() / 1000;
          simMat.uniforms.textureA.value = rtA.texture;

          renderer.setRenderTarget(rtB);
          renderer.render(simScene, simCamera);

          const tmp = rtA;
          rtA = rtB;
          rtB = tmp;

          renderMat.uniforms.textureA.value = rtA.texture;
          renderer.setRenderTarget(null);
          renderer.render(renderScene, renderCamera);
        }
        animate();

        // ── pointer (window-level so pointer-events:none still works) ─
        window.addEventListener("pointermove", (e) => {
          if (!parent.dataset.active) {
            mouse.set(0, 0);
            return;
          }

          const rect = canvas.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          if (x >= 0 && x <= rect.width && y >= 0 && y <= rect.height) {
            mouse.set(
              x * (SIM / rect.width),
              (rect.height - y) * (SIM / rect.height),
            );
          } else {
            mouse.set(0, 0);
          }
        });

        // ── resize ────────────────────────────────────────────────────
        const ro = new ResizeObserver(() => {
          const nw = Math.max(parent.offsetWidth, 1);
          const nh = Math.max(parent.offsetHeight, 1);
          if (nw === pw && nh === ph) return;
          pw = nw;
          ph = nh;
          canvas.width = pw;
          canvas.height = ph;
          renderer.setSize(pw, ph);
        });
        ro.observe(parent);

        // ── cleanup ───────────────────────────────────────────────────
        const dispose = () => {
          renderer.dispose();
          simMat.dispose();
          renderMat.dispose();
          imageTexture.dispose();
          rtA.dispose();
          rtB.dispose();
          ro.disconnect();
          delete (canvas as any).__dispose;
        };

        (canvas as any).__dispose = dispose;

        document.addEventListener("astro:before-swap", dispose, { once: true });
      });
  }

  if (document.readyState === "complete") {
    initFluidOverlays();
  } else {
    window.addEventListener("load", initFluidOverlays);
  }

  document.addEventListener("astro:after-swap", initFluidOverlays);
</script>

<style>
  @keyframes fluid-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .fluid-overlay-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    animation: fluid-in 1s ease-out forwards;
  }

  /*
    Условие ровно обратное тому, при котором инициализируется шейдер
    (см. CAN_HOVER_FX выше). Там, где скрипт не запускается, канвас
    убирается из потока, и остаётся статичная обложка из разметки —
    так две картинки никогда не накладываются друг на друга.
  */
  @media (max-width: 1023px), (hover: none), (prefers-reduced-motion: reduce) {
    .fluid-overlay-canvas {
      display: none;
    }
  }
</style>
