<script>
  import Lenis from "lenis";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { Draggable } from "gsap/Draggable";

  let lenis: Lenis | null = null;
  let cleanup: (() => void) | null = null;

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const initSmoothScroll = () => {
    gsap.registerPlugin(ScrollTrigger, Draggable);

    cleanup?.();
    cleanup = null;

    // Системная настройка «уменьшить движение»: инерционный скролл —
    // это тоже движение, причём то, от которого укачивает сильнее
    // всего. Отдаём прокрутку браузеру целиком.
    if (prefersReducedMotion()) {
      (window as any).lenis = null;
      return null;
    }

    lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    function updateLenis(time: number) {
      lenis?.raf(time * 1000);
    }

    const syncMenuPosition = () => {
      (window as any).syncMenuPositionGlobal?.();
      const drawer = document.querySelector(".menu-drawer");
      if (drawer) {
        Draggable.get(drawer)?.update(true);
      }
    };

    const handleLenisScroll = () => {
      ScrollTrigger.update();
      syncMenuPosition();
    };

    lenis.on("scroll", handleLenisScroll);
    gsap.ticker.add(updateLenis);
    gsap.ticker.lagSmoothing(0);

    const handleAnchorClick = (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest('a[href*="#"]');
      if (!target) return;

      if (typeof (window as any).closeMenuGlobal === "function") {
        (window as any).closeMenuGlobal?.();
      }
      syncMenuPosition();

      const href = target.getAttribute("href");
      if (!href) return;
      const targetId = href.split("#")[1];

      if (targetId || href === "#") {
        e.preventDefault();
        const el = href === "#" ? 0 : document.querySelector(`#${targetId}`);
        if (el !== null) {
          lenis?.scrollTo(el as HTMLElement, {
            duration: 1.5,
            lock: true,
            onComplete: () => {
              syncMenuPosition();
            },
          });
        }
      }
    };

    document.addEventListener("click", handleAnchorClick);

    /* Скролл забран у браузера, поэтому его штатное «доехать до
       сфокусированного элемента» больше не работает: Tab уводит фокус
       за пределы экрана, страница остаётся на месте, и человек жмёт
       Enter вслепую. Это единственная причина, по которой инерционный
       скролл роняет проверку с клавиатуры — догоняем вручную.
       Пропускаем клики: там элемент уже в кадре, и лишний доскролл
       дёргал бы страницу под курсором. */
    const handleFocusIn = (e: FocusEvent) => {
      const el = e.target as HTMLElement | null;
      if (!el || typeof el.getBoundingClientRect !== "function") return;
      if (el.matches(".skip-link")) return;
      if (el.matches(":focus-visible") === false) return;

      const r = el.getBoundingClientRect();
      const margin = 120;
      const above = r.top < margin;
      const below = r.bottom > window.innerHeight - margin;
      if (!above && !below) return;

      lenis?.scrollTo(el, { offset: -window.innerHeight / 2, duration: 0.6 });
    };

    document.addEventListener("focusin", handleFocusIn);

    (window as any).lenis = lenis;

    cleanup = () => {
      lenis?.destroy();
      lenis = null;
      gsap.ticker.remove(updateLenis);
      ScrollTrigger.removeEventListener("refresh", syncMenuPosition);
      document.removeEventListener("click", handleAnchorClick);
      document.removeEventListener("focusin", handleFocusIn);
      syncMenuPosition();
    };

    ScrollTrigger.addEventListener("refresh", syncMenuPosition);
    syncMenuPosition();

    return cleanup;
  };

  initSmoothScroll();

  document.addEventListener("astro:after-swap", initMenuOnSwap);

  function initMenuOnSwap() {
    initSmoothScroll();
  }

  document.addEventListener("astro:before-preparation", () => {
    cleanup?.();
  });
</script>
