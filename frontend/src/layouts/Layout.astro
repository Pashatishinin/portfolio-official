---
import { FluidScene, PageTransition, PreLoader } from "../components";
import SmoothScroll from "../components/animation/SmoothScroll.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Portfolio of Pavlo Tishynin, a UI/UX Designer and Frontend Developer specializing in high-end digital experiences. Bridging the gap between aesthetic design and functional, creative code."
    />
    <title>Pavlo Tishynin</title>
    <ClientRouter />
  </head>
  <body>
    <PreLoader />
    <!-- <PageTransition /> -->
    <FluidScene transition:persist client:visible />
    <SmoothScroll />
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-main);
  }

  body {
    scroll-behavior: smooth;
    overflow-x: clip;
    margin: 0 auto;
  }

  .preloader-visited .preloader {
    display: none !important;
  }

  ::view-transition-old(root) {
    animation: none;
    opacity: 0;
    z-index: 1;
  }

  ::view-transition-new(root) {
    animation-name: var(--vt-anim, none);
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    animation-fill-mode: both;
    transform-origin: center center;
    z-index: 2;
  }

  @keyframes slide-up {
    0% {
      transform: rotate(-10deg) scale(1.4);
    }
    10% {
      transform: rotate(-10deg) scale(1.4);
    }
    100% {
      transform: rotate(0deg) scale(1);
    }
  }
</style>

<script is:inline>
  function updateHeroDelay() {
    const navEntries = performance.getEntriesByType("navigation");
    const isReload = navEntries.length > 0 && navEntries[0].type === "reload";
    const isFirstLoad = !sessionStorage.getItem("alreadyVisited");
    window.HERO_DELAY = isFirstLoad || isReload ? 3.6 : 0.2;
  }

  updateHeroDelay();

  document.addEventListener("astro:before-preparation", (ev) => {
    if (ev.to.pathname === "/") {
      document.documentElement.style.setProperty("--vt-anim", "slide-up");
    }
  });

  document.addEventListener("astro:after-swap", () => {
    window.HERO_DELAY = 0.2;
    document.body.classList.add("preloader-visited");
  });

  document.addEventListener("astro:page-load", () => {
    document.documentElement.style.removeProperty("--vt-anim");
  });
</script>
