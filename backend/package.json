{
	"name": "backend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env scripts/dev.ts",
		"start": "tsx --env-file-if-exists=.env scripts/dev.ts",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"dev:worker": "wrangler dev --port 8787",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.3",
		"@hono/zod-validator": "^0.9.1",
		"@neon/config": "^1.8.3",
		"@neon/env": "^1.5.0",
		"@neondatabase/serverless": "^1.2.0",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.13",
		"hono-auth-core": "^0.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"wrangler": "^4.147.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
