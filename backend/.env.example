# Copy to .env and fill in. Never commit .env.

PORT=8787

# Where this API and the Astro site live (no trailing slash)
API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:4321

# Only these Google accounts can sign in (comma-separated)
OWNER_EMAILS=you@gmail.com

# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local: leave COOKIE_DOMAIN empty. Production with api.example.com: COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Neon → your project → Connect. Use a separate "dev" branch locally, "main" in production.
# Pooled connection string (host contains "-pooler") — used by the API:
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct connection string (no "-pooler") — used by migrations. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
